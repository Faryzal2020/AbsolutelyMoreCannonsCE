<?xml version="1.0" encoding="utf-8"?><Defs>

  <SoundDef>
    <defName>AMC_Vulcan_SpinUp</defName>  
    <context>MapOnly</context>
    <eventNames />  
    <maxSimultaneous>30</maxSimultaneous>  
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>AMC_Vulcan_SpinUp</clipPath>
          </li>
        </grains>
        <pitchRange>
          <min>0.9</min>        
          <max>1.1</max>
        </pitchRange>       
        <volumeRange>
          <min>100</min>        
          <max>100</max>
        </volumeRange>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>
  
  <SoundDef>
    <defName>AMC_Vulcan_SpinDown</defName>  
    <context>MapOnly</context>
    <eventNames />  
    <maxSimultaneous>30</maxSimultaneous>  
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>AMC_Vulcan_SpinDown</clipPath>
          </li>
        </grains>
        <pitchRange>
          <min>0.8</min>        
          <max>0.9</max>
        </pitchRange>       
        <volumeRange>
          <min>80</min>        
          <max>85</max>
        </volumeRange>
        <sustainLoop>False</sustainLoop>
