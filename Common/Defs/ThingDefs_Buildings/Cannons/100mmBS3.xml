<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== M1944 BS-3 ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_100mmBS3_Base</defName>
		<label>M1944 BS-3</label>
    <description>The M1944 BS-3 was a Soviet heavy anti-tank gun introduced late in WWII, capable of destroying even the heaviest enemy armor. It requires reloading after each shot and has no indirect fire capability. Power: None, HP: 400, Cooldown: 10.0s, Range: 110, Rate of Fire: 6 rounds per minute. Ammunition types: 100mm BR-412D (AP, Penetration: 239), 100mm OF-412 (HE, Explosion Radius: 5).</description>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M100mmBS3</texPath>
			<drawSize>(10,10)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M100mmBS3_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToBuild>16500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>300</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>Turret_100mmBS3_Weapon</turretGunDef>
      <turretTopDrawSize>14</turretTopDrawSize>
			<turretBurstCooldownTime>10</turretBurstCooldownTime>
		</building>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_EnclosedTurret">
				<explosiveProtection>0.2</explosiveProtection>  <!-- blast damage reduction (fragments go through the shield check instead) -->
				<flameProtection>0</flameProtection>             <!-- open top: no fire protection -->
				<meleeProtection>0</meleeProtection>             <!-- open top: no melee protection -->
				<generalProtection>0</generalProtection>           <!-- open top: no protection from unclassified damage -->
				<temperatureProtection>0</temperatureProtection> <!-- open top: no climate protection -->
				<hidePawnGraphics>false</hidePawnGraphics>
				<!-- Open-top seat & gun shield (placeholder values, tune in game) -->
				<seatOffset>(0.5,0,-1)</seatOffset>  <!-- turret-top frame: +Z along barrel, +X barrel's right -->
				<shieldArc>110</shieldArc>             
				<shieldHeight>1.5</shieldHeight>      <!-- shield top above ground (barrelHeight 1.2 - 0.25) -->
				<shieldArmor>20</shieldArmor>          <!-- mm RHA: stops rifle FMJ (CE 6-7), not AP / .50 -->
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.5</swayReduction>
				<recoilReduction>0.5</recoilReduction>
				<spreadReduction>0.5</spreadReduction>
			</li>
			<!-- Fire Arc Control -->
			<li Class="CombatExtended.CompProperties_FireArc">
				<!-- Minimum and maximum arc span in degrees -->
				<spanRange>
					<min>30</min>  <!-- Minimum firing arc width -->
					<max>180</max> <!-- Maximum firing arc width (full circle) -->
				</spanRange>
				
				<!-- Maximum rotation from turret's facing direction -->
				<!-- 360 = can rotate to any direction -->
				<!-- 90 = can only rotate 90° left/right from facing -->
				<maxSpanDeviation>90</maxSpanDeviation>
				
				<!-- Visual indicator line length when adjusting -->
				<lineLength>10</lineLength>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 5)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>30</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<muzzleParticleSize>1.5</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>5</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.6</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.1</decayIncrease>

				<heatOffset>(0, 0, 1.5)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>2.2</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.5</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>5</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>50</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 4)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>1.8</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_100mmBS3</li>
		</researchPrerequisites>
    	<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<modExtensions>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<!-- Turn speed in degrees per tick (e.g. 0.5 = 30°/sec, 1.0 = 60°/sec, 2.0 = 120°/sec) -->
				<speed>1.5</speed> 
				<!-- Angle range (in degrees) preferred for target selection -->
				<preferedAngleRange>30</preferedAngleRange>
				<!-- Multiplier for angle weighting in target scoring -->
				<angleWeightMultiplier>1.5</angleWeightMultiplier>
				<!-- Minimum weight divisor to prevent division by zero -->
				<minAngleWeight>0.1</minAngleWeight>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretSuppressionImmunityExtension">
				<preventOperatorSuppression>true</preventOperatorSuppression>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretTrackingExtension">
				<enableMidBurstTracking>true</enableMidBurstTracking>
			</li>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelHeight>1.2</barrelHeight>
				<turretHeadWeight>2.1</turretHeadWeight>
			<barrelGraphic>
				<texPath>Things/Building/M100mmBS3_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<underBarrelGraphic>
				<texPath>Things/Building/M100mmBS3_UnderBarrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</underBarrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>14.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>0.5</maxDistance>
				<recoilDuration>10</recoilDuration>
				<returnDuration>20</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<projectileSpawnOffset>4</projectileSpawnOffset>
				<durationTicks>10</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
				<flashSize>30</flashSize>
				<flashBrightness>2.5</flashBrightness>
				<flashOffset>-3</flashOffset>  <!-- Offset from barrel tip -->
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>      <!-- Full brightness at start -->
					<li>(0.3, 0.9)</li>  <!-- Still bright -->
					<li>(0.6, 0.6)</li>  <!-- Fading -->
					<li>(1, 0)</li>      <!-- Faded out -->
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_100mmBS3_Weapon</defName>
		<label>M1944 BS-3 Gun</label>
		<graphicData>
			<texPath>Things/Building/M100mmBS3_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:100mm BR-412D \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.06</ShotSpread>
			<SwayFactor>0.18</SwayFactor>
			<RangedWeapon_Cooldown>10</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.35</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_100mmBS3_APHE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>7</minRange>
				<range>110</range>
				<soundCast>Sound_Russian100mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>70</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_100mmBS3_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-0.5</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretClampingExtension">
				<maxVerticalDeviation>2</maxVerticalDeviation>
				<maxRotationDeviation>2</maxRotationDeviation>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretLightPenaltyExtension">
				<pitchDarkGlowThreshold>0.20</pitchDarkGlowThreshold>
				<litPenaltyMultiplier>0.15</litPenaltyMultiplier>
				<darkPenaltyMultiplier>1</darkPenaltyMultiplier>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>