<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== Pak 40 ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_75mmPak40_Base</defName>
		<label>Pak 40</label>
    <description>The Pak 40 was Germany's primary towed anti-tank gun during WWII, known for its reliability and firepower. It requires reloading after each shot and has no indirect fire capability. Power: None, HP: 360, Cooldown: 5.0s, Range: 100, Rate of Fire: 12 rounds per minute. Ammunition types: 75mm Pzgr 39 (AP, Penetration: 138), 75mm Sprgr 34 (HE, Explosion Radius: 3).</description>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M75mmPak40</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M75mmPak40_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>360</MaxHitPoints>
			<WorkToBuild>11000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>200</Steel>
       		<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>Turret_75mmPak40_Weapon</turretGunDef>
       		<turretTopDrawSize>14</turretTopDrawSize>
			<turretBurstCooldownTime>5</turretBurstCooldownTime>
		</building>
		<comps>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.5</swayReduction>
				<recoilReduction>0.5</recoilReduction>
				<spreadReduction>0.5</spreadReduction>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_75mmPak40</li>
		</researchPrerequisites>
    	<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
			<barrelGraphic>
				<texPath>Things/Building/M75mmPak40_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<underBarrelGraphic>
				<texPath>Things/Building/M75mmPak40_UnderBarrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</underBarrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>14.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>1.5</maxDistance>
				<recoilDuration>8</recoilDuration>
				<returnDuration>21</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>9</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
				<flashSize>15</flashSize>
				<flashBrightness>2</flashBrightness>
				<flashOffset>0</flashOffset>  <!-- Offset from barrel tip -->
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>      <!-- Full brightness at start -->
					<li>(0.3, 0.9)</li>  <!-- Still bright -->
					<li>(0.6, 0.6)</li>  <!-- Fading -->
					<li>(1, 0)</li>      <!-- Faded out -->
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_75mmPak40_Weapon</defName>
		<label>Pak 40 Gun</label>
		<graphicData>
			<texPath>Things/Building/M75mmPak40_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:75mm Pzgr 39 \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.5</SwayFactor>
			<RangedWeapon_Cooldown>5</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_75mmPAK40_APHE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>4</minRange>
				<range>100</range>
				<soundCast>Sound_75mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_75mmPAK40_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-0.5</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>