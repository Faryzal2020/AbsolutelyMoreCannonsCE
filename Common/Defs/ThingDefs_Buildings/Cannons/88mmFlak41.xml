<?xml version='1.0' encoding='utf-8'?>
<Defs>
									
	

	<ThingDef ParentName="AMCTurretMannedBase"> 
		<defName>Turret_88mmFlak41_Base</defName>
		<label>Flak 41</label>
    <description>Manned: Yes, Power: None, HP: 400, Cooldown: 8.0s, Range: 6-100, Rate of Fire: 8 rounds per minute, Burst Count: 1, Magazine: 1, Reload: 1.0s. Germany's improved dual-purpose anti-aircraft and anti-tank gun.</description>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M88mmFlak41</texPath>
			<drawSize>(13,13)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M88mmFlak41_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToBuild>16000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>250</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>Turret_88mmFlak41_Weapon</turretGunDef>
      <turretTopDrawSize>13</turretTopDrawSize>
			<turretBurstCooldownTime>8</turretBurstCooldownTime>
		</building>
		<comps>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.5</swayReduction>
				<recoilReduction>0.5</recoilReduction>
				<spreadReduction>0.5</spreadReduction>
			</li>
			
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> 
				<muzzleOffset>(0, 0, 4)</muzzleOffset> 
				<muzzleVelocity>15</muzzleVelocity> 
				<muzzleVelDuration>30</muzzleVelDuration> 
				<muzzleParticleSize>1.5</muzzleParticleSize> 
				<muzzleSpawnDelay>1</muzzleSpawnDelay> 
				
				
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>3</heatThreshold> 
				<heatDecayRate>0.72</heatDecayRate> 
				<decayIncrease>0.15</decayIncrease>

				<heatOffset>(0, 0, 1.5)</heatOffset> 

				<heatEmissionRate>2.5</heatEmissionRate> 
				<emissionIncrease>0.6</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> 
				<heatEmissionPoints>3</heatEmissionPoints> 
				<heatEmissionSpacing>0.5</heatEmissionSpacing> 
				
				
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>4</shockwaveRadius> 
				<shockwaveDensity>40</shockwaveDensity> 
				<shockwaveOffset>(0, 0, 4)</shockwaveOffset> 
				<shockwaveParticleSize>1.5</shockwaveParticleSize> 
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_88mmFlak41</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
			<barrelGraphic>
				<texPath>Things/Building/M88mmFlak41_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<underBarrelGraphic>
				<texPath>Things/Building/M88mmFlak41_UnderBarrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</underBarrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>13.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>1</maxDistance>
				<recoilDuration>10</recoilDuration>
				<returnDuration>35</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>9</durationTicks>  
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>  
				<flashSize>15</flashSize>
				<flashBrightness>2</flashBrightness>
				<flashOffset>0</flashOffset>  
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>      
					<li>(0.3, 0.9)</li>  
					<li>(0.6, 0.6)</li>  
					<li>(1, 0)</li>      
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_88mmFlak41_Weapon</defName>
		<label>Flak 41 Gun</label>
		<graphicData>
			<texPath>Things/Building/M88mmFlak41_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:88mm Pzgr 39 \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.5</SwayFactor>
			<RangedWeapon_Cooldown>8</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_88mmFLAK41_APHE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>6</minRange>
				<range>100</range>
				<soundCast>Sound_88mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_88mmFLAK41_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-0.5</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>