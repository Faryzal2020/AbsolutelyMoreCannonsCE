<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== M247 ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_40mmM247_Base</defName>
		<label>M247</label>
    <description>Use ammo set:40x365mm M811 \nThe American M247 Sergeant York was designed for armored anti-aircraft support with twin 40mm Bofors cannons. It carries a 580-round magazine and is incapable of settlement bombardment. Power: 200, HP: 765, Cooldown: 0.5s, Range: 5-80, Rate of Fire: 300 rounds per minute, Aimed Burst: 2, Reload Time: 5s.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M40mmM247</texPath>
			<drawSize>(11,11)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M40mmM247_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>765</MaxHitPoints>
			<WorkToBuild>16000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>500</Steel>
			<Plasteel>10</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_40mmM247_Weapon</turretGunDef>
      <turretTopDrawSize>15</turretTopDrawSize>
			<turretBurstCooldownTime>0.5</turretBurstCooldownTime>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>1</muzzleParticleCount>
				<muzzleSpawnDuration>1</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 3)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>20</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>30</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>1.5~3</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>60</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.6</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.1</decayIncrease>

				<heatOffset>(0, 0, 2.5)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>1</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>1</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>1</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>2</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 4)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>3</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_40mmM247</li>
		</researchPrerequisites>
    <interactionCellOffset>(-1,0,-2)</interactionCellOffset>
    <modExtensions>
      <li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
        <barrelGraphic>
          <texPath>Things/Building/M40mmM247_Barrel</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(3,3)</drawSize>
        </barrelGraphic>
        <barrelOffset>(0,0,0.0)</barrelOffset>
        <barrelDrawSize>15.0</barrelDrawSize>
        <drawOnTop>false</drawOnTop>
        <barrelAmount>2</barrelAmount>
        <barrelSpacing>0.5</barrelSpacing>
		<sequentialFiring>true</sequentialFiring>
		<selectableBurstCounts>
			<li>4</li>
			<li>8</li>
			<li>12</li>
		</selectableBurstCounts>
        <recoilAnimation>
          <maxDistance>0.6</maxDistance>
          <recoilDuration>20</recoilDuration>
          <returnDuration>15</returnDuration>
          <useRecoilCurve>true</useRecoilCurve>
          <useReturnCurve>false</useReturnCurve>
          <affectsRotation>false</affectsRotation>
        </recoilAnimation>
        <firingAnimation>
          <enabled>true</enabled>
          <durationTicks>9</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
		  <drawFlash>true</drawFlash>
		  <flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
		  <flashSize>15</flashSize>
		  <flashBrightness>2</flashBrightness>
		  <flashOffset>-2</flashOffset>  <!-- Offset from barrel tip -->
		  <muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
		  <flashIntensityCurve>
			<points>
			<li>(0, 1)</li>      <!-- Full brightness at start -->
			<li>(0.3, 0.9)</li>  <!-- Still bright -->
			<li>(0.6, 0.6)</li>  <!-- Fading -->
			<li>(1, 0)</li>      <!-- Faded out -->
			</points>
		  </flashIntensityCurve>
        </firingAnimation>
      </li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_40mmM247_Weapon</defName>
		<label>M247 Gun</label>
		<graphicData>
			<texPath>Things/Building/M40mmM247_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:40x365mm M811 \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>2</SightsEfficiency>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>0.9</SwayFactor>
			<RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Small_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_40x365mm_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>5</minRange>
				<range>80</range>
				<soundCast>Sound_M247</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>35</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>12</ticksBetweenBurstShots>
				<burstShotCount>8</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker> <!--
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>10</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos> -->
			</li>
		</verbs>
		<comps> <!--
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
				</chargeSpeeds>
			</li> -->
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>580</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_40x365mm_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>TRUE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
        <aimedBurstShotCount>2</aimedBurstShotCount>
      </li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>1.5,1.5</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>