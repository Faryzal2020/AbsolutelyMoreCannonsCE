<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== DCA 40 ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_40mmDCA40_Base</defName>
		<label>DCA 40</label>
    <description>Use ammo set:40x365mm M811 \nThe DCA 40 single 40mm autocannon was developed by France for anti-air duties. It holds an 80-round magazine and is incapable of settlement bombardment. Power: N/A, HP: 400, Cooldown: 0.8s, Range: 4-60, Rate of Fire: 327 rounds per minute, Aimed Burst: 3, Reload Time: 5s.</description>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M40mmDCA40</texPath>
			<drawSize>(7,7)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M40mmDCA40_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToBuild>7000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>300</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>Turret_40mmDCA40_Weapon</turretGunDef>
            <turretTopDrawSize>7</turretTopDrawSize>
			<turretBurstCooldownTime>0.8</turretBurstCooldownTime>
		</building>
		<comps>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_40mmDCA40</li>
		</researchPrerequisites>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
			<barrelGraphic>
				<texPath>Things/Building/M40mmDCA40_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>7.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<selectableBurstCounts>
				<li>2</li>
				<li>4</li>
				<li>8</li>
			</selectableBurstCounts>
			<recoilAnimation>
				<maxDistance>0.3</maxDistance>
				<recoilDuration>5</recoilDuration>
				<returnDuration>7</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>9</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
				<flashSize>12</flashSize>
				<flashBrightness>2</flashBrightness>
				<flashOffset>1</flashOffset>  <!-- Offset from barrel tip -->
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>      <!-- Full brightness at start -->
					<li>(0.3, 0.9)</li>  <!-- Still bright -->
					<li>(0.6, 0.6)</li>  <!-- Fading -->
					<li>(1, 0)</li>      <!-- Faded out -->
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_40mmDCA40_Weapon</defName>
		<label>DCA 40 Gun</label>
		<graphicData>
			<texPath>Things/Building/M40mmDCA40_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:40x365mm M811 \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>0.9</SwayFactor>
			<RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Small_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_40x365mm_AP</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>4</minRange>
				<range>60</range>
				<soundCast>Sound_40mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>30</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>11</ticksBetweenBurstShots>
				<burstShotCount>4</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker> <!--
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>10</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos> -->
			</li>
		</verbs>
		<comps> <!--
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
				</chargeSpeeds>
			</li> -->
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>80</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_40x365mm_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>TRUE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
        <aimedBurstShotCount>2</aimedBurstShotCount>
      </li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,0</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>