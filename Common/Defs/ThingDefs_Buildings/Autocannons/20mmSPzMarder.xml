<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== SPz Marder ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_20mmSPzMarder_Base</defName>
		<label>SPz Marder</label>
    <description>Use ammo set:20x139mm HE-T \nThe German SPz Marder IFV mounts a rapid-firing 20mm Rheinmetall autocannon for infantry support. It has a large 1250-round magazine and is incapable of settlement bombardment. Power: 100, HP: 475, Cooldown: 1.5s, Range: 3-70, Rate of Fire: 720 rounds per minute, Aimed Burst: 4, Reload Time: 5s.</description>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M20mmSPzMarder</texPath>
			<drawSize>(13,13)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M20mmSPzMarder_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>475</MaxHitPoints>
			<WorkToBuild>6000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>250</Steel>
			<Plasteel>2</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_20mmSPzMarder_Weapon</turretGunDef>
      <turretTopDrawSize>14</turretTopDrawSize>
			<turretBurstCooldownTime>1.5</turretBurstCooldownTime>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>100</basePowerConsumption>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>2,2</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_20mmSPzMarder</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <modExtensions>
      <li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
        <barrelGraphic>
          <texPath>Things/Building/M20mmSPzMarder_Barrel</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(3,3)</drawSize>
        </barrelGraphic>
        <underBarrelGraphic>
          <texPath>Things/Building/M20mmSPzMarder_UnderBarrel</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(3,3)</drawSize>
        </underBarrelGraphic>
        <barrelOffset>(0,0,0.0)</barrelOffset>
        <barrelDrawSize>14.0</barrelDrawSize>
        <drawOnTop>false</drawOnTop>
        <barrelAmount>1</barrelAmount>
		<selectableBurstCounts>
			<li>6</li>
			<li>10</li>
			<li>15</li>
		</selectableBurstCounts>
        <recoilAnimation>
          <maxDistance>0.2</maxDistance>
          <recoilDuration>1</recoilDuration>
          <returnDuration>2</returnDuration>
          <useRecoilCurve>true</useRecoilCurve>
          <useReturnCurve>false</useReturnCurve>
          <affectsRotation>false</affectsRotation>
        </recoilAnimation>
        <firingAnimation>
          <enabled>true</enabled>
          <durationTicks>4</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
		  <drawFlash>true</drawFlash>
		  <flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
		  <flashSize>10</flashSize>
		  <flashBrightness>1</flashBrightness>
		  <flashOffset>-4.2</flashOffset>  <!-- Offset from barrel tip -->
		  <muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
		  <flashIntensityCurve>
			<points>
			<li>(0, 1)</li>      <!-- Full brightness at start -->
			<li>(0.3, 0.9)</li>  <!-- Still bright -->
			<li>(0.6, 0.6)</li>  <!-- Fading -->
			<li>(1, 0)</li>      <!-- Faded out -->
			</points>
		  </flashIntensityCurve>
        </firingAnimation>
      </li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_20mmSPzMarder_Weapon</defName>
		<label>SPz Marder Gun</label>
		<graphicData>
			<texPath>Things/Building/M20mmSPzMarder_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:20x139mm HE-T \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>2.5</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.4</SwayFactor>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Small_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_20x139mm_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>3</minRange>
				<range>70</range>
				<soundCast>Sound_RH202</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>25</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<burstShotCount>15</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker> <!--
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>10</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos> -->
			</li>
		</verbs>
		<comps> <!--
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
				</chargeSpeeds>
			</li> -->
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1250</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_20x139mm_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>TRUE</aiUseBurstMode>
		<noSingleShot>true</noSingleShot>
        <aiAimMode>AimedShot</aiAimMode>
        <aimedBurstShotCount>4</aimedBurstShotCount>
      </li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-0.5</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>