<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== BMP-2 ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_30mmBMP2_Base</defName>
		<label>BMP-2</label>
    	<description>Use ammo set:30x165mm HE-I \nThe Soviet BMP-2 IFV carries a 30mm 2A42 autocannon capable of engaging infantry and light vehicles. It has a 500-round magazine and is incapable of settlement bombardment. Power: 100, HP: 525, Cooldown: 1.0s, Range: 3-70, Rate of Fire: 514 rounds per minute, Aimed Burst: 4, Reload Time: 5s.</description>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M30mmBMP2</texPath>
			<drawSize>(13,13)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M30mmBMP2_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>525</MaxHitPoints>
			<WorkToBuild>8000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>300</Steel>
			<Plasteel>2</Plasteel>
        <ComponentIndustrial>8</ComponentIndustrial>
        <ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_30mmBMP2_Weapon</turretGunDef>
        	<turretTopDrawSize>14</turretTopDrawSize>
			<turretBurstCooldownTime>1</turretBurstCooldownTime>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>100</basePowerConsumption>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_30mmBMP2</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <modExtensions>
      <li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
        <barrelGraphic>
          <texPath>Things/Building/M30mmBMP2_Barrel</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(3,3)</drawSize>
        </barrelGraphic>
        <barrelOffset>(0,0,0.0)</barrelOffset>
        <barrelDrawSize>14.0</barrelDrawSize>
        <drawOnTop>false</drawOnTop>
        <barrelAmount>1</barrelAmount>
        <recoilAnimation>
          <maxDistance>0.6</maxDistance>
          <recoilDuration>20</recoilDuration>
          <returnDuration>15</returnDuration>
          <useRecoilCurve>true</useRecoilCurve>
          <useReturnCurve>false</useReturnCurve>
          <affectsRotation>false</affectsRotation>
        </recoilAnimation>
        <firingAnimation>
          <enabled>true</enabled>
          <durationTicks>9</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
		  <drawFlash>true</drawFlash>
		  <flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
		  <flashSize>15</flashSize>
		  <flashBrightness>2.5</flashBrightness>
		  <flashOffset>-2</flashOffset>  <!-- Offset from barrel tip -->
		  <muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
		  <flashIntensityCurve>
			<points>
			<li>(0, 1)</li>      <!-- Full brightness at start -->
			<li>(0.3, 0.9)</li>  <!-- Still bright -->
			<li>(0.6, 0.6)</li>  <!-- Fading -->
			<li>(1, 0)</li>      <!-- Faded out -->
			</points>
		  </flashIntensityCurve>
        </firingAnimation>
      </li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_30mmBMP2_Weapon</defName>
		<label>BMP-2 Gun</label>
		<graphicData>
			<texPath>Things/Building/M30mmBMP2_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:30x165mm HE-I \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>2</SightsEfficiency>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>0.5</SwayFactor>
			<RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Small_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_30x165mm_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>3</minRange>
				<range>70</range>
				<soundCast>Sound_BMP2</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>30</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
				<burstShotCount>8</burstShotCount>
				<recoilPattern>Mounted</recoilPattern> <!--
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>10</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos> -->
			</li>
		</verbs>
		<comps> <!--
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
				</chargeSpeeds>
			</li> -->
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>500</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_30x165mm_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>TRUE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
        <aimedBurstShotCount>4</aimedBurstShotCount>
      </li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-0.5</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>