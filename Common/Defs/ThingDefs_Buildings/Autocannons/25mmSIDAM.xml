<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== SIDAM 25 ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_25mmSIDAM_Base</defName>
		<label>SIDAM 25</label>
    	<description>Use ammo set:25x137mm M792 \nThe Italian SIDAM 25 mounts quad 25mm Oerlikon KBA cannons for mobile anti-air defense. It holds a 600-round magazine and is incapable of settlement bombardment. Power: 200, HP: 585, Cooldown: 0.1s, Range: 3-80, Rate of Fire: 600 rounds per minute, Aimed Burst: 4, Reload Time: 5s.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M25mmSIDAM</texPath>
			<drawSize>(15,15)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M25mmSIDAM_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>585</MaxHitPoints>
			<WorkToBuild>9000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>340</Steel>
			<Plasteel>5</Plasteel>
        <ComponentIndustrial>6</ComponentIndustrial>
        <ComponentSpacer>6</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_25mmSIDAM_Weapon</turretGunDef>
      		<turretTopDrawSize>16</turretTopDrawSize>
			<turretBurstCooldownTime>0.1</turretBurstCooldownTime>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_EnclosedTurret">
				<bulletProtection>1.0</bulletProtection>     <!-- 100% immunity to bullets -->
				<explosiveProtection>0.8</explosiveProtection>  <!-- 80% reduced explosive/bomb damage -->
				<temperatureProtection>0.5</temperatureProtection> <!-- Safe even inside burning/freezing rooms -->
				<hidePawnGraphics>true</hidePawnGraphics>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>1</muzzleParticleCount>
				<muzzleSpawnDuration>-5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 3)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>30</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>2</directionCone>
				<muzzleParticleSize>1~1.5</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>120</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.6</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.1</decayIncrease>

				<heatOffset>(0, 0, 0)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>1</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.5</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>false</shockwaveEnabled>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>2,2</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_25mmSIDAM</li>
		</researchPrerequisites>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
			<barrelGraphic>
				<texPath>Things/Building/M25mmSIDAM_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<underBarrelGraphic>
				<texPath>Things/Building/M25mmSIDAM_UnderBarrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</underBarrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>16.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>2</barrelAmount>
			<barrelSpacing>1.35</barrelSpacing>
			<sequentialFiring>true</sequentialFiring>
			<selectableBurstCounts>
				<li>6</li>
				<li>10</li>
				<li>16</li>
			</selectableBurstCounts>
			<recoilAnimation>
				<maxDistance>0.2</maxDistance>
				<recoilDuration>2</recoilDuration>
				<returnDuration>3</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>4</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.8,0.45,1)</flashColor>  <!-- Orange/yellow -->
				<flashSize>10</flashSize>
				<flashBrightness>1</flashBrightness>
				<flashOffset>-5.2</flashOffset>  <!-- Offset from barrel tip -->
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>      <!-- Full brightness at start -->
					<li>(0.3, 0.9)</li>  <!-- Still bright -->
					<li>(0.6, 0.6)</li>  <!-- Fading -->
					<li>(1, 0)</li>      <!-- Faded out -->
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_25mmSIDAM_Weapon</defName>
		<label>SIDAM 25 Gun</label>
		<graphicData>
			<texPath>Things/Building/M25mmSIDAM_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:25x137mm M792 \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>2</SightsEfficiency>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>0.5</SwayFactor>
			<RangedWeapon_Cooldown>0.1</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Small_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_25x137mm_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>3</minRange>
				<range>80</range>
				<soundCast>Sound_SIDAM</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>30</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
				<burstShotCount>10</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker> <!--
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>10</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos> -->
			</li>
		</verbs>
		<comps> <!--
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
				</chargeSpeeds>
			</li> -->
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>600</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_25x137mm_Shells</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<noSingleShot>true</noSingleShot>
				<aiAimMode>AimedShot</aiAimMode>
				<aimedBurstShotCount>4</aimedBurstShotCount>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>1,-1</CasingOffset>
				<CasingAngleOffset>90</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>