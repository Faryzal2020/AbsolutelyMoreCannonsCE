<?xml version='1.0' encoding='UTF-8'?>
<Defs>
									
	<!--=============== Flak 38 ===============-->

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_20mmFlak38_Base</defName>
		<label>Flak 38</label>
    <description>Use ammo set:20x138mm Swiss \nThe 2cm Flak 38 was developed by Nazi Germany as a versatile anti-aircraft autocannon during WWII. It requires reloading after each 8-shot burst and is incapable of settlement bombardment. Power: N/A, HP: 340, Cooldown: 0.4s, Range: 2-50, Rate of Fire: 150 rounds per minute, Aimed Burst: 4, Reload Time: 1s.</description>
		<constructionSkillPrerequisite>2</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M20mmFlak38</texPath>
			<drawSize>(9,9)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M20mmFlak38_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>340</MaxHitPoints>
			<WorkToBuild>4500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>150</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>Turret_20mmFlak38_Weapon</turretGunDef>
      <turretTopDrawSize>9</turretTopDrawSize>
			<turretBurstCooldownTime>0.4</turretBurstCooldownTime>
		</building>
		<comps>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel"/>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_20mmFlak38</li>
		</researchPrerequisites>
    <interactionCellOffset>(1,0,-1)</interactionCellOffset>
    <modExtensions>
      <li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
        <barrelGraphic>
          <texPath>Things/Building/M20mmFlak38_Barrel</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(3,3)</drawSize>
        </barrelGraphic>
        <barrelOffset>(0,0,0.0)</barrelOffset>
        <barrelDrawSize>9.0</barrelDrawSize>
        <drawOnTop>false</drawOnTop>
        <barrelAmount>1</barrelAmount>
        <recoilAnimation>
          <maxDistance>0.4</maxDistance>
          <recoilDuration>6</recoilDuration>
          <returnDuration>8</returnDuration>
          <useRecoilCurve>true</useRecoilCurve>
          <useReturnCurve>false</useReturnCurve>
          <affectsRotation>false</affectsRotation>
        </recoilAnimation>
        <firingAnimation>
          <enabled>true</enabled>
          <durationTicks>8</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
		  <drawFlash>true</drawFlash>
		  <flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
		  <flashSize>8</flashSize>
		  <flashBrightness>0.8</flashBrightness>
		  <flashOffset>-1</flashOffset>  <!-- Offset from barrel tip -->
		  <muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
		  <flashIntensityCurve>
			<points>
			<li>(0, 1)</li>      <!-- Full brightness at start -->
			<li>(0.3, 0.9)</li>  <!-- Still bright -->
			<li>(0.6, 0.6)</li>  <!-- Fading -->
			<li>(1, 0)</li>      <!-- Faded out -->
			</points>
		  </flashIntensityCurve>
        </firingAnimation>
      </li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_20mmFlak38_Weapon</defName>
		<label>Flak 38 Gun</label>
		<graphicData>
			<texPath>Things/Building/M20mmFlak38_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Use ammo set:20x138mm Swiss \nHas Indirect version:No \nShelling Range:0</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>0.9</SwayFactor>
			<RangedWeapon_Cooldown>0.4</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Small_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_20x138mm_AP</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>2</minRange>
				<range>50</range>
				<soundCast>Sound_Flak38</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>20</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>24</ticksBetweenBurstShots>
				<burstShotCount>8</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker> <!--
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>10</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos> -->
			</li>
		</verbs>
		<comps> <!--
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
				</chargeSpeeds>
			</li> -->
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>32</magazineSize>
				<reloadTime>2</reloadTime>
				<ammoSet>AmmoSet_20x138mm_Shells</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
				<aimedBurstShotCount>2</aimedBurstShotCount>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-0.5</CasingOffset>
				<CasingAngleOffset>0</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>