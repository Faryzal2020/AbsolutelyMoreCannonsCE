<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== Auto 5"/54 (12.7 cm) Mark 16 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_U127mmMark16</defName>
		<label>Auto 5"/54 (12.7 cm) Mark 16</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretAutoBase"> 
		<defName>Turret_U127mmMark16_Base</defName>
		<label>Auto 5&quot;/54 (12.7 cm) Mark 16 (Auto)</label>
    <description>The Auto 5"/54 (12.7 cm) Mark 16 is a US Navy destroyer gun adapted for automated land-based bombardment. It has an internal magazine (Mag Size: 200), indirect fire capability, and requires 900 power to operate. Power: 900, HP: 2060, Cooldown: 3.3s, Range: 23700, Indirect Range: 10-23700, Rate of Fire: 36 rounds per minute. Ammunition: HE (Explosion Radius 3.5). Capable of settlement bombardment.</description>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/U127mmMark16</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/U127mmMark16_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2060</MaxHitPoints>
			<WorkToBuild>55000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
      <AimingAccuracy>0.95</AimingAccuracy>
		</statBases>
		<costList>
      <Steel>1100</Steel>
      <ComponentIndustrial>20</ComponentIndustrial>
      <Plasteel>35</Plasteel>
      <ComponentSpacer>6</ComponentSpacer>
    </costList>
		<building>
			<turretGunDef>Turret_U127mmMark16_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
      <turretTopDrawSize>16</turretTopDrawSize>
			<turretBurstCooldownTime>3.3</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_U127mmMark16</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>900</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_U127mmMark16_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
			<swayReduction>0.1</swayReduction>
			<recoilReduction>0.1</recoilReduction>
			<spreadReduction>0.1</spreadReduction>
		</li>
			
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleVelocity>15</muzzleVelocity>
				<muzzleParticleSize>1~2</muzzleParticleSize>
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>20</heatThreshold>
				<heatDecayRate>0.48</heatDecayRate>
				<heatEmissionRate>3.5</heatEmissionRate>
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>5</shockwaveRadius>
				<shockwaveDensity>50</shockwaveDensity>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretFCS" />
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_U127mmMark16</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/M127mmMark16_Barrel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>16.0</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<recoilAnimation>
					<maxDistance>0.3</maxDistance>
					<recoilDuration>15</recoilDuration>
					<returnDuration>30</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>5.5</projectileSpawnOffset>
					<durationTicks>10</durationTicks>  
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>  
					<flashSize>30</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-7</flashOffset>  
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  
					<flashIntensityCurve>
						<points>
						<li>(0, 1)</li>      
						<li>(0.3, 0.9)</li>  
						<li>(0.6, 0.6)</li>  
						<li>(1, 0)</li>      
						</points>
					</flashIntensityCurve>
				</firingAnimation>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>Turret_U127mmMark16_Weapon</defName>
		<label>Auto 5"/54 (12.7 cm) Mark 16 Gun</label>
		<graphicData>
			<texPath>Things/Building/U127mmMark16_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The Auto 5"/54 (12.7 cm) Mark 16 is a US Navy destroyer gun adapted for automated land-based bombardment. It has an internal magazine (Mag Size: 200), indirect fire capability, and requires 900 power to operate. Power: 900, HP: 6200, Cooldown: 3.3s, Range: 23700, Indirect Range: 10-23700, Rate of Fire: 36 rounds per minute. Ammunition: HE (Explosion Radius 3.5). Capable of settlement bombardment.</description>
		<statBases>
			<SightsEfficiency>2.9</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>3.3</RangedWeapon_Cooldown>
      <NightVisionEfficiency_Weapon>1</NightVisionEfficiency_Weapon>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmMark16_HE</defaultProjectile>
				<warmupTime>3.0500000000000003</warmupTime>
        <minRange>8</minRange>
				<range>120</range>
				<soundCast>Sound_Single127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>200</magazineSize>
				<reloadTime>0.5</reloadTime>
				<ammoSet>AmmoSet_127mmMark16_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>FALSE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
      </li>
		</comps>
	</ThingDef>

