<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== Auto AEC Deacon ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_U57mmDeacon</defName>
		<label>Auto AEC Deacon</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretAutoBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_U57mmDeacon_Base</defName>
		<label>Auto AEC Deacon (Auto)</label>
    	<description>The Auto AEC Deacon is a British 6-pounder self-propelled gun retrofitted with automatic targeting systems. It has an internal magazine (Mag Size: 60) and requires 500 power to operate. Power: 500, HP: 518, Cooldown: 4.0s, Range: 110, Rate of Fire: 15 rounds per minute. Ammunition: AP (Penetration 116 / 177). Not capable of settlement bombardment.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/U57mmDeacon</texPath>
			<drawSize>(11,11)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/U57mmDeacon_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>518</MaxHitPoints>
			<WorkToBuild>11250</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
			<AimingAccuracy>0.95</AimingAccuracy>
		</statBases>
		<costList>
			<Steel>450</Steel>
      		<ComponentIndustrial>4</ComponentIndustrial>
			<Plasteel>5</Plasteel>
      		<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_U57mmDeacon_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
      		<turretTopDrawSize>11</turretTopDrawSize>
			<turretBurstCooldownTime>4</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_U57mmDeacon</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>500</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.5</swayReduction>
				<recoilReduction>0.5</recoilReduction>
				<spreadReduction>0.5</spreadReduction>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 3)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>30</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<muzzleParticleSize>1.5</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>5</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.6</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.1</decayIncrease>

				<heatOffset>(0, 0, 1.5)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>2</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.5</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>4</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>40</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 2)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>1.5</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretFCS" />
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_U57mmDeacon</li>
		</researchPrerequisites>
		<modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
			<barrelGraphic>
				<texPath>Things/Building/U57mmDeacon_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>11.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>0.5</maxDistance>
				<recoilDuration>10</recoilDuration>
				<returnDuration>30</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>9</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
				<flashSize>15</flashSize>
				<flashBrightness>2</flashBrightness>
				<flashOffset>0</flashOffset>  <!-- Offset from barrel tip -->
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>      <!-- Full brightness at start -->
					<li>(0.3, 0.9)</li>  <!-- Still bright -->
					<li>(0.6, 0.6)</li>  <!-- Fading -->
					<li>(1, 0)</li>      <!-- Faded out -->
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>Turret_U57mmDeacon_Weapon</defName>
		<label>Auto AEC Deacon Gun</label>
		<graphicData>
			<texPath>Things/Building/U57mmDeacon_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The Auto AEC Deacon is a British 6-pounder self-propelled gun retrofitted with automatic targeting systems. It has an internal magazine (Mag Size: 60) and requires 500 power to operate. Power: 500, HP: 1600, Cooldown: 4.0s, Range: 110, Rate of Fire: 15 rounds per minute. Ammunition: AP (Penetration 116 / 177). Not capable of settlement bombardment.</description>
		<statBases>
			<SightsEfficiency>2.9</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.3</SwayFactor>
			<RangedWeapon_Cooldown>4</RangedWeapon_Cooldown>
			<NightVisionEfficiency_Weapon>1</NightVisionEfficiency_Weapon>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_57mmOQF_AP</defaultProjectile>
				<warmupTime>3.05</warmupTime>
				<minRange>4</minRange>
				<range>110</range>
				<soundCast>Sound_6Pdr</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>40</muzzleFlashScale>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>60</magazineSize>
				<reloadTime>0.5</reloadTime>
				<ammoSet>AmmoSet_57mmOQF_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>FALSE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
      </li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-1</CasingOffset>
				<CasingAngleOffset>90</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>