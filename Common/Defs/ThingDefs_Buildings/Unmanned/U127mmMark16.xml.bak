<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== Auto 5"/54 (12.7 cm) Mark 16 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_U127mmMark16</defName>
		<label>Auto 5"/54 (12.7 cm) Mark 16</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretAutoBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_U127mmMark16_Base</defName>
		<label>Auto 5"/54 (12.7 cm) Mark 16 (Auto)</label>
    <description>The Auto 5"/54 (12.7 cm) Mark 16 is a US Navy destroyer gun adapted for automated land-based bombardment. It has an internal magazine (Mag Size: 200), indirect fire capability, and requires 900 power to operate. Power: 900, HP: 2060, Cooldown: 3.3s, Range: 23700, Indirect Range: 10-23700, Rate of Fire: 36 rounds per minute. Ammunition: HE (Explosion Radius 3.5). Capable of settlement bombardment.</description>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/U127mmMark16</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/U127mmMark16_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2060</MaxHitPoints>
			<WorkToBuild>55000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
      <AimingAccuracy>0.95</AimingAccuracy>
		</statBases>
		<costList>
			<Steel>1100</Steel>
      <ComponentIndustrial>20</ComponentIndustrial>
			<Plasteel>35</Plasteel>
      <ComponentSpacer>6</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_U127mmMark16_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
      <turretTopDrawSize>16</turretTopDrawSize>
			<turretBurstCooldownTime>3.3</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_U127mmMark16</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>900</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<!-- Add mode swap component -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_U127mmMark16_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.1</swayReduction>
				<recoilReduction>0.1</recoilReduction>
				<spreadReduction>0.1</spreadReduction>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 6)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>40</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>1~2</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>20</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.48</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 3)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>3.5</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>5</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>50</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 5)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>1.5</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretFCS" />
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_U127mmMark16</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/M127mmMark16_Barrel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>16.0</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<recoilAnimation>
					<maxDistance>0.3</maxDistance>
					<recoilDuration>15</recoilDuration>
					<returnDuration>30</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>5.5</projectileSpawnOffset>
					<durationTicks>10</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
					<flashSize>30</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-7</flashOffset>  <!-- Offset from barrel tip -->
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
					<flashIntensityCurve>
						<points>
						<li>(0, 1)</li>      <!-- Full brightness at start -->
						<li>(0.3, 0.9)</li>  <!-- Still bright -->
						<li>(0.6, 0.6)</li>  <!-- Fading -->
						<li>(1, 0)</li>      <!-- Faded out -->
						</points>
					</flashIntensityCurve>
				</firingAnimation>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>Turret_U127mmMark16_Weapon</defName>
		<label>Auto 5"/54 (12.7 cm) Mark 16 Gun</label>
		<graphicData>
			<texPath>Things/Building/U127mmMark16_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The Auto 5"/54 (12.7 cm) Mark 16 is a US Navy destroyer gun adapted for automated land-based bombardment. It has an internal magazine (Mag Size: 200), indirect fire capability, and requires 900 power to operate. Power: 900, HP: 6200, Cooldown: 3.3s, Range: 23700, Indirect Range: 10-23700, Rate of Fire: 36 rounds per minute. Ammunition: HE (Explosion Radius 3.5). Capable of settlement bombardment.</description>
		<statBases>
			<SightsEfficiency>2.9</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>3.3</RangedWeapon_Cooldown>
      <NightVisionEfficiency_Weapon>1</NightVisionEfficiency_Weapon>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmMark16_HE</defaultProjectile>
				<warmupTime>3.0500000000000003</warmupTime>
        <minRange>8</minRange>
				<range>120</range>
				<soundCast>Sound_Single127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>200</magazineSize>
				<reloadTime>0.5</reloadTime>
				<ammoSet>AmmoSet_127mmMark16_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>FALSE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
      </li>
		</comps>
	</ThingDef>

<!-- INDIRECT -->
	<ThingDef ParentName="AMCArtilleryAutoBase">
		<defName>Turret_U127mmMark16_indirect_Base</defName>
		<label>Auto 5"/54 (12.7 cm) Mark 16 (indirect)</label>
    <description>The Auto 5"/54 (12.7 cm) Mark 16 is a US Navy destroyer gun adapted for automated land-based bombardment. It has an internal magazine (Mag Size: 200), indirect fire capability, and requires 900 power to operate. Power: 900, HP: 6200, Cooldown: 3.3s, Range: 23700, Indirect Range: 10-23700, Rate of Fire: 36 rounds per minute. Ammunition: HE (Explosion Radius 3.5). Capable of settlement bombardment.</description>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/U127mmMark16</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/U127mmMark16_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2060</MaxHitPoints>
			<WorkToBuild>55000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
      <AimingAccuracy>1</AimingAccuracy>
      <ShootingAccuracyTurret>1.5</ShootingAccuracyTurret>
		</statBases>
		<costList>
			<Steel>1100</Steel>
      <ComponentIndustrial>20</ComponentIndustrial>
			<Plasteel>35</Plasteel>
      <ComponentSpacer>6</ComponentSpacer>
		</costList>
		<tradeTags>
			<li>CE_Turret</li>
		</tradeTags>
		<building>
			<turretGunDef>Turret_U127mmMark16_indirect_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretBurstCooldownTime>3.3</turretBurstCooldownTime>
      <turretTopDrawSize>16</turretTopDrawSize>
		</building>
		<designatorDropdown>Group_AMC_U127mmMark16</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>900</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<!-- Add mode swap component -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_U127mmMark16_Base</alternateDef>
				<gizmoLabel>Switch to Direct Fire</gizmoLabel>
				<gizmoDesc>Change this turret into direct fire mode (flat trajectory)\nRequires line of sight, higher accuracy</gizmoDesc>
				<gizmoIcon>UI/Buttons/DirectMode</gizmoIcon>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 2)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>20</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<muzzleParticleSize>1.5</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>20</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.48</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 1)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>3.5</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.3</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>5</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>50</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 2)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>1.5</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretFCS" />
		</comps>
    <size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_U127mmMark16</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/U127mmMark16_Barrel_Indirect</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<underBarrelGraphic>
					<texPath>Things/Building/U127mmMark16_UnderBarrel_Indirect</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</underBarrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>16.0</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<recoilAnimation>
					<maxDistance>0.3</maxDistance>
					<recoilDuration>15</recoilDuration>
					<returnDuration>30</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>3</projectileSpawnOffset>
					<durationTicks>10</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
					<flashSize>25</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-9</flashOffset>  <!-- Offset from barrel tip -->
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
					<flashIntensityCurve>
						<points>
						<li>(0, 1)</li>      <!-- Full brightness at start -->
						<li>(0.3, 0.9)</li>  <!-- Still bright -->
						<li>(0.6, 0.6)</li>  <!-- Fading -->
						<li>(1, 0)</li>      <!-- Faded out -->
						</points>
					</flashIntensityCurve>
				</firingAnimation>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_U127mmMark16_indirect_Weapon</defName>
		<label>Auto 5"/54 (12.7 cm) Mark 16 Gun</label>
		<graphicData>
			<texPath>Things/Building/U127mmMark16_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The Auto 5"/54 (12.7 cm) Mark 16 is a US Navy destroyer gun adapted for automated land-based bombardment. It has an internal magazine (Mag Size: 200), indirect fire capability, and requires 900 power to operate. Power: 900, HP: 6200, Cooldown: 3.3s, Range: 23700, Indirect Range: 10-23700, Rate of Fire: 36 rounds per minute. Ammunition: HE (Explosion Radius 3.5). Capable of settlement bombardment.</description>
		<statBases>
			<SightsEfficiency>2.9</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>3.3</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<recoilAmount>1.5</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmMark16_indirect_HE</defaultProjectile>
				<warmupTime>3.0500000000000003</warmupTime>
        <minRange>10</minRange>
				<range>23700</range>
				<soundCast>Sound_Single127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>1</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
					<li>80</li>
					<li>90</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>200</magazineSize>
				<reloadTime>0.5</reloadTime>
				<ammoSet>AmmoSet_127mmMark16_indirect_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>
	
</Defs>