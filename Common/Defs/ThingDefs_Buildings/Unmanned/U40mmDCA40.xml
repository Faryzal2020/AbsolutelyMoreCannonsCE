<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== Auto DCA 40 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_U40mmDCA40</defName>
		<label>Auto DCA 40</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretAutoBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_U40mmDCA40_Base</defName>
		<label>Auto DCA 40 (Auto)</label>
    <description>The Auto DCA 40 is a French 40mm twin anti-aircraft turret modified for unmanned operation. It has an internal magazine (Mag Size: 160) and requires 300 power to operate. Power: 300, HP: 460, Cooldown: 0.8s, Range: 80, Rate of Fire: 75 rounds per minute. Ammunition: AP (Penetration 94). Not capable of settlement bombardment.</description>
		<constructionSkillPrerequisite>7</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/U40mmDCA40</texPath>
			<drawSize>(6,6)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/U40mmDCA40_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>460</MaxHitPoints>
			<WorkToBuild>8750</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
      <AimingAccuracy>0.95</AimingAccuracy>
		</statBases>
		<costList>
			<Steel>400</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
			<Plasteel>5</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_U40mmDCA40_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
      <turretTopDrawSize>6</turretTopDrawSize>
			<turretBurstCooldownTime>0.8</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_U40mmDCA40</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>1</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 3)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>30</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>1.5~1.8</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>35</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.5</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.1</decayIncrease>

				<heatOffset>(0, 0, 1.5)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>1</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>1</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>1</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>2</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 4)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>3</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretFCS" />
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_U40mmDCA40</li>
		</researchPrerequisites>
		<modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
			<barrelGraphic>
				<texPath>Things/Building/U40mmDCA40_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>6.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<selectableBurstCounts>
				<li>2</li>
				<li>4</li>
				<li>8</li>
			</selectableBurstCounts>
			<recoilAnimation>
				<maxDistance>0.3</maxDistance>
				<recoilDuration>5</recoilDuration>
				<returnDuration>7</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>9</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
				<flashSize>12</flashSize>
				<flashBrightness>2</flashBrightness>
				<flashOffset>1</flashOffset>  <!-- Offset from barrel tip -->
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>      <!-- Full brightness at start -->
					<li>(0.3, 0.9)</li>  <!-- Still bright -->
					<li>(0.6, 0.6)</li>  <!-- Fading -->
					<li>(1, 0)</li>      <!-- Faded out -->
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>Turret_U40mmDCA40_Weapon</defName>
		<label>Auto DCA 40 Gun</label>
		<graphicData>
			<texPath>Things/Building/U40mmDCA40_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The Auto DCA 40 is a French 40mm twin anti-aircraft turret modified for unmanned operation. It has an internal magazine (Mag Size: 160) and requires 300 power to operate. Power: 300, HP: 1100, Cooldown: 0.8s, Range: 80, Rate of Fire: 75 rounds per minute. Ammunition: AP (Penetration 94). Not capable of settlement bombardment.</description>
		<statBases>
			<SightsEfficiency>2.9</SightsEfficiency>
			<ShotSpread>0.02</ShotSpread>
			<SwayFactor>0.4</SwayFactor>
			<RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown>
      <NightVisionEfficiency_Weapon>1</NightVisionEfficiency_Weapon>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Small_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_40x365mm_AP</defaultProjectile>
				<warmupTime>3.05</warmupTime>
        <minRange>4</minRange>
				<range>80</range>
				<soundCast>Sound_40mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>30</muzzleFlashScale>
				<ticksBetweenBurstShots>11</ticksBetweenBurstShots>
				<burstShotCount>6</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>160</magazineSize>
				<reloadTime>0.5</reloadTime>
				<ammoSet>AmmoSet_40x365mm_Shells</ammoSet>
			</li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>TRUE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
        <aimedBurstShotCount>2</aimedBurstShotCount>
      </li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<CasingOffset>0,-1</CasingOffset>
				<CasingAngleOffset>90</CasingAngleOffset>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>