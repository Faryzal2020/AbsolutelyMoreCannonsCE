<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 2S1 Gvozdika ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_122mmGvozdika</defName>
		<label>2S1 Gvozdika</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_122mmGvozdika_Base</defName>
		<label>2S1 Gvozdika</label>
    <description>The 2S1 Gvozdika was a Soviet self-propelled howitzer developed in the 1970s for mobile artillery support. It has an indirect fire variant, features an internal magazine of 40 rounds, and is capable of settlement bombardment. Power: 200, HP: 720, Cooldown: 10.0s, Range: 15300, Shelling Range: 18. Ammunition: 122mm OF-462 (HE, Damage: 279, Explosion Radius: 3.5), 122mm OF-462 (Airburst, fragmentation, anti-infantry).</description>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M122mmGvozdika</texPath>
			<drawSize>(13,13)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M122mmGvozdika_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>720</MaxHitPoints>
			<WorkToBuild>27500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>500</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
			<Plasteel>5</Plasteel>
		</costList>
		<building>
			<turretGunDef>Turret_122mmGvozdika_Weapon</turretGunDef>
      <turretTopDrawSize>13</turretTopDrawSize>
			<turretBurstCooldownTime>10</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_122mmGvozdika</designatorDropdown>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>3</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 4.5)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>30</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>15~25</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>3~5</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>4</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.2</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 1.5)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>3.5</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>3</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.7</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>3</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>40</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 5)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>2</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
				<shockwaveFadeOutSpeed>0.5</shockwaveFadeOutSpeed> <!-- fade out speed multiplier (1.0 = default) -->
				<shockwaveGradientDensity>false</shockwaveGradientDensity> <!-- gradient density (1.0 = 100% at center, 0.1 = 10% at edge) -->
				<shockwaveGradientParticleSize>true</shockwaveGradientParticleSize> <!-- gradient particle size (1.0 = 100% at center, 0.1 = 10% at edge) -->
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_EnclosedTurret">
				<bulletProtection>1.0</bulletProtection>     <!-- 100% immunity to bullets -->
				<explosiveProtection>0.8</explosiveProtection>  <!-- 80% reduced explosive/bomb damage -->
				<temperatureProtection>0.5</temperatureProtection> <!-- Safe even inside burning/freezing rooms -->
				<hidePawnGraphics>true</hidePawnGraphics>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_122mmGvozdika_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretAmmoCookOff">
				<maxExplosiveRadius>8.0</maxExplosiveRadius>
				<maxDamage>320</maxDamage>
				<minPenForCookOff>15</minPenForCookOff>
				<highPenForCookOff>50</highPenForCookOff>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_122mmGvozdika</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension"> <!-- PLACEHOLDER: copied unadjusted, needs visual tuning (values from 152mmMsta) -->
			<barrelHeight>1.5</barrelHeight>
			<barrelGraphic>
				<texPath>Things/Building/M122mmGvozdika_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>13.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>2</maxDistance>
				<recoilDuration>30</recoilDuration>
				<returnDuration>100</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<projectileSpawnOffset>4.5</projectileSpawnOffset>
				<durationTicks>10</durationTicks>
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>
				<flashSize>30</flashSize>
				<flashBrightness>3.0</flashBrightness>
				<flashOffset>-1</flashOffset>
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>
					<li>(0.3, 0.9)</li>
					<li>(0.6, 0.6)</li>
					<li>(1, 0)</li>
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
    	<li Class="CombatExtended.NonSnapTurretExtension">
    		<speed>0.4</speed>
    		<preferedAngleRange>15</preferedAngleRange>
    		<minAngleWeight>0.1</minAngleWeight>
    	</li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_122mmGvozdika_Weapon</defName>
		<label>2S1 Gvozdika Gun</label>
		<graphicData>
			<texPath>Things/Building/M122mmGvozdika_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 2S1 Gvozdika was a Soviet self-propelled howitzer developed in the 1970s for mobile artillery support. It has an indirect fire variant, features an internal magazine of 40 rounds, and is capable of settlement bombardment. Power: 200, HP: 720, Cooldown: 10.0s, Range: 15300, Shelling Range: 18. Ammunition: 122mm OF-462 (HE, Damage: 279, Explosion Radius: 3.5), 122mm OF-462 (Airburst, fragmentation, anti-infantry).</description>
		<statBases>
			<SightsEfficiency>5</SightsEfficiency>
			<ShotSpread>0.25</ShotSpread>
			<SwayFactor>0.18</SwayFactor>
			<RangedWeapon_Cooldown>10</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.25</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_122mm2A12_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>6</minRange>
				<range>250</range>
				<soundCast>Sound_122mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>40</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_122mm2A12_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretLightPenaltyExtension" />
		</modExtensions>
	</ThingDef>

