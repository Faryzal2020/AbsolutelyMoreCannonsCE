<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 2A3 Kondensator 2P ===============-->

<!-- INDIRECT -->
	<ThingDef ParentName="AMCArtilleryBase">
		<defName>Turret_406mm2A3_indirect_Base</defName>
		<label>2A3 Kondensator 2P (indirect)</label>
    	<description>The 2A3 Kondensator 2P was a Soviet experimental nuclear-capable self-propelled howitzer developed during the Cold War. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 700, HP: 5145, Cooldown: 80.0s, Range: 25600, Shelling Range: 24. Ammunition: 406mm W23 (HE, Damage: 3162, Explosion Radius: 50, Secondary Damage: 50, Secondary Damage Type: Thermobaric, Secondary Damage Radius: 100).</description>
		<constructionSkillPrerequisite>7</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M406mm2A3</texPath>
			<drawSize>(27,27)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M406mm2A3_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>5145</MaxHitPoints>
			<WorkToBuild>80000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>1700</Steel>
      		<ComponentIndustrial>15</ComponentIndustrial>
			<Plasteel>60</Plasteel>
      		<ComponentSpacer>4</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_406mm2A3_indirect_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretBurstCooldownTime>0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
      <turretTopDrawSize>28</turretTopDrawSize>
		</building>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker"> <!-- PLACEHOLDER: copied unadjusted, needs visual tuning (values from 75mmPak40) -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration>
				<muzzleOffset>(0, 0, 3)</muzzleOffset>
				<muzzleVelocity>15</muzzleVelocity>
				<muzzleVelDuration>30</muzzleVelDuration>
				<muzzleParticleSize>1.5</muzzleParticleSize>
				<muzzleSpawnDelay>1</muzzleSpawnDelay>
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>4</heatThreshold>
				<heatDecayRate>0.9</heatDecayRate>
				<decayIncrease>0.12</decayIncrease>
				<heatOffset>(0, 0, 1.5)</heatOffset>
				<heatEmissionRate>2</heatEmissionRate>
				<emissionIncrease>0.4</emissionIncrease>
				<heatParticleSize>0.6</heatParticleSize>
				<heatEmissionPoints>3</heatEmissionPoints>
				<heatEmissionSpacing>0.5</heatEmissionSpacing>
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>4</shockwaveRadius>
				<shockwaveDensity>40</shockwaveDensity>
				<shockwaveOffset>(0, 0, 4)</shockwaveOffset>
				<shockwaveParticleSize>1.5</shockwaveParticleSize>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>600</basePowerConsumption>
			</li>
		</comps>
    <size>(7,7)</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_406mm2A3</li>
		</researchPrerequisites>
    <interactionCellOffset>(2,0,-4)</interactionCellOffset>
    <modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension"> <!-- PLACEHOLDER: copied unadjusted, needs visual tuning (values from 152mmMsta) -->
			<barrelGraphic>
				<texPath>Things/Building/M406mm2A3_Barrel_Indirect</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>28.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>1</maxDistance>
				<recoilDuration>30</recoilDuration>
				<returnDuration>100</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>10</durationTicks>
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>
				<flashSize>35</flashSize>
				<flashBrightness>3.0</flashBrightness>
				<flashOffset>-4</flashOffset>
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>
					<li>(0.3, 0.9)</li>
					<li>(0.6, 0.6)</li>
					<li>(1, 0)</li>
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
    	<li Class="CombatExtended.NonSnapTurretExtension">
    		<speed>0.1</speed>
    		<preferedAngleRange>15</preferedAngleRange>
    		<minAngleWeight>0.1</minAngleWeight>
    	</li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_406mm2A3_indirect_Weapon</defName>
		<label>2A3 Kondensator 2P Gun</label>
		<graphicData>
			<texPath>Things/Building/M406mm2A3_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 2A3 Kondensator 2P was a Soviet experimental nuclear-capable self-propelled howitzer developed during the Cold War. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 700, HP: 6500, Cooldown: 80.0s, Range: 25600, Shelling Range: 24. Ammunition: 406mm W23 (HE, Damage: 3162, Explosion Radius: 28.5).</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<recoilAmount>2</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_406mm2A3_indirect_Nuclear</defaultProjectile>
				<warmupTime>10</warmupTime>
        <minRange>100</minRange>
				<range>25600</range>
				<soundCast>Sound_406mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>200</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>1</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>70</li>
					<li>90</li>
					<li>120</li>
					<li>160</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>60</reloadTime>
				<ammoSet>AmmoSet_406mm2A3_indirect_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretClampingExtension">
				<maxVerticalDeviation>2</maxVerticalDeviation>
				<maxRotationDeviation>2</maxRotationDeviation>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>