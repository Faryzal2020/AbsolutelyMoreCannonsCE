<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 2S3 Akatsiya ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_152mmAkatsiya</defName>
		<label>2S3 Akatsiya</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_152mmAkatsiya_Base</defName>
		<label>2S3 Akatsiya</label>
    <description>The 2S3 Akatsiya was a Soviet self-propelled howitzer designed to provide heavy indirect fire support. It has an indirect fire variant, features an internal magazine of 46 rounds, and is capable of settlement bombardment. Power: 450, HP: 1280, Cooldown: 15.0s, Range: 18500, Shelling Range: 24. Ammunition: 152mm OF-540 (HE, Damage: 386, Explosion Radius: 4.5).</description>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M152mmAkatsiya</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M152mmAkatsiya_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>1280</MaxHitPoints>
			<WorkToBuild>32500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>600</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
			<Plasteel>5</Plasteel>
		</costList>
		<building>
			<turretGunDef>Turret_152mmAkatsiya_Weapon</turretGunDef>
      <turretTopDrawSize>14</turretTopDrawSize>
			<turretBurstCooldownTime>15</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_152mmAkatsiya</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_152mmAkatsiya_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_152mmAkatsiya</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_152mmAkatsiya_Weapon</defName>
		<label>2S3 Akatsiya Gun</label>
		<graphicData>
			<texPath>Things/Building/M152mmAkatsiya_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 2S3 Akatsiya was a Soviet self-propelled howitzer designed to provide heavy indirect fire support. It has an indirect fire variant, features an internal magazine of 46 rounds, and is capable of settlement bombardment. Power: 450, HP: 2000, Cooldown: 15.0s, Range: 18500, Shelling Range: 24. Ammunition: 152mm OF-540 (HE, Damage: 386, Explosion Radius: 4.5).</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.02</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>15</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_152mm2A65_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>6</minRange>
				<range>18500</range>
				<soundCast>Sound_152mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>22</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>46</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_152mm2A65_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

<!-- INDIRECT -->
	<ThingDef ParentName="AMCArtilleryBase">
		<defName>Turret_152mmAkatsiya_indirect_Base</defName>
		<label>2S3 Akatsiya (indirect)</label>
    <description>The 2S3 Akatsiya was a Soviet self-propelled howitzer designed to provide heavy indirect fire support. It has an indirect fire variant, features an internal magazine of 46 rounds, and is capable of settlement bombardment. Power: 450, HP: 2000, Cooldown: 15.0s, Range: 18500, Shelling Range: 24. Ammunition: 152mm OF-540 (HE, Damage: 386, Explosion Radius: 4.5).</description>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M152mmAkatsiya</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M152mmAkatsiya_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>1280</MaxHitPoints>
			<WorkToBuild>32500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>600</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
			<Plasteel>5</Plasteel>
		</costList>
		<building>
			<turretGunDef>Turret_152mmAkatsiya_indirect_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretBurstCooldownTime>15</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
      <turretTopDrawSize>14</turretTopDrawSize>
		</building>
		<designatorDropdown>Group_AMC_152mmAkatsiya</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_152mmAkatsiya_Base</alternateDef>
				<gizmoLabel>Switch to Direct Fire</gizmoLabel>
				<gizmoDesc>Change this turret into direct fire mode (flat trajectory)\nRequires line of sight, higher accuracy</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
		</comps>
    <size>(4,4)</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_152mmAkatsiya</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
	</ThingDef>
	
	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_152mmAkatsiya_indirect_Weapon</defName>
		<label>2S3 Akatsiya Gun</label>
		<graphicData>
			<texPath>Things/Building/M152mmAkatsiya_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 2S3 Akatsiya was a Soviet self-propelled howitzer designed to provide heavy indirect fire support. It has an indirect fire variant, features an internal magazine of 46 rounds, and is capable of settlement bombardment. Power: 450, HP: 2000, Cooldown: 15.0s, Range: 18500, Shelling Range: 24. Ammunition: 152mm OF-540 (HE, Damage: 386, Explosion Radius: 4.5).</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.9</SwayFactor>
			<RangedWeapon_Cooldown>15</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<recoilAmount>1.5</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_152mm2A65_indirect_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>25</minRange>
				<range>18500</range>
				<soundCast>Sound_152mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>22</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>1</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>50</li>
					<li>75</li>
					<li>100</li>
					<li>125</li>
					<li>150</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>46</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_152mm2A65_indirect_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>
	
</Defs>