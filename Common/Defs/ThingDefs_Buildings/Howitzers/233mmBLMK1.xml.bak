<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 9.2in BL Howitzer Mk.1 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_233mmBLMK1</defName>
		<label>9.2in BL Howitzer Mk.1</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_233mmBLMK1_Base</defName>
		<label>9.2in BL Howitzer Mk.1</label>
    	<description>The 9.2in BL Howitzer Mk.1 was a British heavy howitzer used during World War I for siege operations. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 3360, Cooldown: 50.0s, Range: 9000, Shelling Range: 12. Ammunition: 9.2 Inch Mk.I (HE, Damage: 462, Explosion Radius: 5.0).</description>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M233mmBLMK1</texPath>
			<drawSize>(10,10)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M233mmBLMK1_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>3360</MaxHitPoints>
			<WorkToBuild>70000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>700</Steel>
      		<ComponentIndustrial>5</ComponentIndustrial>
			<Plasteel>10</Plasteel>
		</costList>
		<building>
			<turretGunDef>Turret_233mmBLMK1_Weapon</turretGunDef>
      		<turretTopDrawSize>10</turretTopDrawSize>
			<turretBurstCooldownTime>0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_233mmBLMK1</designatorDropdown>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_233mmBLMK1_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 20+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>4,6</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_233mmBLMK1</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_233mmBLMK1_Weapon</defName>
		<label>9.2in BL Howitzer Mk.1 Gun</label>
		<graphicData>
			<texPath>Things/Building/M233mmBLMK1_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 9.2in BL Howitzer Mk.1 was a British heavy howitzer used during World War I for siege operations. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 1300, Cooldown: 50.0s, Range: 9000, Shelling Range: 12. Ammunition: 9.2 Inch Mk.I (HE, Damage: 462, Explosion Radius: 5.0).</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_233mmBLMK1_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<minRange>10</minRange>
				<range>9000</range>
				<soundCast>Sound_288mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>35</reloadTime>
				<ammoSet>AmmoSet_233mmBLMK1_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

<!-- INDIRECT -->
	<ThingDef ParentName="AMCArtilleryBase">
		<defName>Turret_233mmBLMK1_indirect_Base</defName>
		<label>9.2in BL Howitzer Mk.1 (indirect)</label>
    	<description>The 9.2in BL Howitzer Mk.1 was a British heavy howitzer used during World War I for siege operations. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 1300, Cooldown: 50.0s, Range: 9000, Shelling Range: 12. Ammunition: 9.2 Inch Mk.I (HE, Damage: 462, Explosion Radius: 5.0).</description>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M233mmBLMK1</texPath>
			<drawSize>(10,10)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M233mmBLMK1_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>3360</MaxHitPoints>
			<WorkToBuild>70000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>700</Steel>
      		<ComponentIndustrial>5</ComponentIndustrial>
			<Plasteel>10</Plasteel>
		</costList>
		<building>
			<turretGunDef>Turret_233mmBLMK1_indirect_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretBurstCooldownTime>0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
      		<turretTopDrawSize>10</turretTopDrawSize>
		</building>
		<designatorDropdown>Group_AMC_233mmBLMK1</designatorDropdown>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_233mmBLMK1_Base</alternateDef>
				<gizmoLabel>Switch to Direct Fire</gizmoLabel>
				<gizmoDesc>Change this turret into direct fire mode (flat trajectory)\nRequires line of sight, higher accuracy</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
		</comps>
    	<size>(4,6)</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_233mmBLMK1</li>
		</researchPrerequisites>
    	<interactionCellOffset>(0,0,-3)</interactionCellOffset>
	</ThingDef>
	
	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_233mmBLMK1_indirect_Weapon</defName>
		<label>9.2in BL Howitzer Mk.1 Gun</label>
		<graphicData>
			<texPath>Things/Building/M233mmBLMK1_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 9.2in BL Howitzer Mk.1 was a British heavy howitzer used during World War I for siege operations. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 1300, Cooldown: 50.0s, Range: 9000, Shelling Range: 12. Ammunition: 9.2 Inch Mk.I (HE, Damage: 462, Explosion Radius: 5.0).</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.9</SwayFactor>
			<RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<recoilAmount>1.5</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_233mmBLMK1_indirect_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>20</minRange>
				<range>9000</range>
				<soundCast>Sound_288mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>1</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>60</li>
					<li>90</li>
					<li>120</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>35</reloadTime>
				<ammoSet>AmmoSet_233mmBLMK1_indirect_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretClampingExtension">
				<maxVerticalDeviation>2</maxVerticalDeviation>
				<maxRotationDeviation>2</maxRotationDeviation>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>