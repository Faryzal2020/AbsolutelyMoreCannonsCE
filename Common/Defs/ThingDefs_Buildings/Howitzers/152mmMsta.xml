<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 2S19 Msta ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_152mmMsta</defName>
		<label>2S19 Msta</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_152mmMsta_Base</defName>
		<label>2S19 Msta</label>
    <description>The 2S19 Msta was a Soviet self-propelled howitzer introduced in the late 1980s to replace earlier models. It has an indirect fire variant, features an internal magazine of 50 rounds, and is capable of settlement bombardment. Power: 500, HP: 2625, Cooldown: 9.0s, Range: 24700, Shelling Range: 24. Ammunition: 152mm OF-540 (HE, Damage: 386, Explosion Radius: 4.5), 152mm OF-540 (Airburst, fragmentation, anti-infantry).</description>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/5x5Base/M152mmMsta</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(7,7)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M152mmMsta_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2625</MaxHitPoints>
			<WorkToBuild>45000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>900</Steel>
      <ComponentIndustrial>15</ComponentIndustrial>
			<Plasteel>5</Plasteel>
      <ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_152mmMsta_Weapon</turretGunDef>
      		<turretTopDrawSize>20</turretTopDrawSize>
			<turretBurstCooldownTime>9</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_152mmMsta</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>500</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_EnclosedTurret">
				<bulletProtection>1.0</bulletProtection>     <!-- 100% immunity to bullets -->
				<explosiveProtection>0.8</explosiveProtection>  <!-- 80% reduced explosive/bomb damage -->
				<temperatureProtection>0.5</temperatureProtection> <!-- Safe even inside burning/freezing rooms -->
				<hidePawnGraphics>true</hidePawnGraphics>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>4</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 7.5)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>20</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>20~30</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>3~4</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>12</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.24</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 7)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>3.5</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>4</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>5</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>50</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 6.5)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>2.5</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
				<shockwaveFadeOutSpeed>0.4</shockwaveFadeOutSpeed> <!-- fade out speed multiplier (1.0 = default) -->
				<shockwaveGradientDensity>false</shockwaveGradientDensity> <!-- gradient density (1.0 = 100% at center, 0.1 = 10% at edge) -->
				<shockwaveGradientParticleSize>true</shockwaveGradientParticleSize> <!-- gradient particle size (1.0 = 100% at center, 0.1 = 10% at edge) -->
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_152mmMsta_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.8</swayReduction>
				<recoilReduction>0.8</recoilReduction>
				<spreadReduction>0.8</spreadReduction>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretAmmoCookOff">
				<maxExplosiveRadius>9.5</maxExplosiveRadius>
				<maxDamage>400</maxDamage>
				<minPenForCookOff>16</minPenForCookOff>
				<highPenForCookOff>55</highPenForCookOff>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>5,5</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_152mmMsta</li>
		</researchPrerequisites>
    	<interactionCellOffset>(0,0,-3)</interactionCellOffset>

    <modExtensions>
      <li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
        <barrelHeight>2.1</barrelHeight>
        <barrelGraphic>
          <texPath>Things/Building/M152mmMsta_Barrel</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(3,3)</drawSize>
        </barrelGraphic>
        <barrelOffset>(0,0,0.0)</barrelOffset>
        <barrelDrawSize>20.0</barrelDrawSize>
        <drawOnTop>false</drawOnTop>
        <recoilAnimation>
          <maxDistance>1</maxDistance>
          <recoilDuration>30</recoilDuration>
          <returnDuration>35</returnDuration>
          <useRecoilCurve>true</useRecoilCurve>
          <useReturnCurve>false</useReturnCurve>
          <affectsRotation>false</affectsRotation>
        </recoilAnimation>
        <firingAnimation>
          <enabled>true</enabled>
          <durationTicks>10</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
		  <drawFlash>true</drawFlash>
		  <flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
		  <flashSize>30</flashSize>
		  <flashBrightness>3.0</flashBrightness>
		  <flashOffset>-1</flashOffset>  <!-- Offset from barrel tip -->
		  <muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
		  <flashIntensityCurve>
			<points>
			<li>(0, 1)</li>      <!-- Full brightness at start -->
			<li>(0.3, 0.9)</li>  <!-- Still bright -->
			<li>(0.6, 0.6)</li>  <!-- Fading -->
			<li>(1, 0)</li>      <!-- Faded out -->
			</points>
		  </flashIntensityCurve>
        </firingAnimation>
      </li>
      <li Class="CombatExtended.NonSnapTurretExtension">
      	<speed>0.35</speed>
      	<preferedAngleRange>15</preferedAngleRange>
      	<minAngleWeight>0.1</minAngleWeight>
      </li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_152mmMsta_Weapon</defName>
		<label>2S19 Msta Gun</label>
		<graphicData>
			<texPath>Things/Building/M152mmMsta_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 2S19 Msta was a Soviet self-propelled howitzer introduced in the late 1980s to replace earlier models. It has an indirect fire variant, features an internal magazine of 50 rounds, and is capable of settlement bombardment. Power: 500, HP: 2625, Cooldown: 9.0s, Range: 24700, Shelling Range: 24. Ammunition: 152mm OF-540 (HE, Damage: 386, Explosion Radius: 4.5), 152mm OF-540 (Airburst, fragmentation, anti-infantry).</description>
		<statBases>
			<SightsEfficiency>5</SightsEfficiency>
			<ShotSpread>0.25</ShotSpread>
			<SwayFactor>0.18</SwayFactor>
			<RangedWeapon_Cooldown>9</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.25</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_152mm2A65_HE</defaultProjectile>
				<warmupTime>3</warmupTime>
				<minRange>7</minRange>
				<range>250</range>
				<soundCast>Sound_152mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>22</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>50</magazineSize>
				<reloadTime>2</reloadTime>
				<ammoSet>AmmoSet_152mm2A65_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretLightPenaltyExtension" />
		</modExtensions>
	</ThingDef>

