<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 7.5 cm le.IG 18 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_75mmLEIG18</defName>
		<label>7.5 cm le.IG 18</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_75mmLEIG18_Base</defName>
		<label>7.5 cm le.IG 18</label>
    <description>The 7.5 cm le.IG 18 was a German infantry support howitzer introduced in the 1930s. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: None, HP: 315, Reload: 6.0s, Range: 3550, Shelling Range: 6. Ammunition: 75mm Jgr. 18 (HE, Damage: 120, Explosion Radius: 2.5).</description>
		<constructionSkillPrerequisite>2</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M75mmLEIG18</texPath>
			<drawSize>(7,7)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M75mmLEIG18_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>315</MaxHitPoints>
			<WorkToBuild>9000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>300</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>Turret_75mmLEIG18_Weapon</turretGunDef>
      <turretTopDrawSize>7</turretTopDrawSize>
			<turretBurstCooldownTime>0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_75mmLEIG18</designatorDropdown>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker"> <!-- PLACEHOLDER: copied unadjusted, needs visual tuning (values from 75mmPak40) -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration>
				<muzzleOffset>(0, 0, 3)</muzzleOffset>
				<muzzleVelocity>15</muzzleVelocity>
				<muzzleVelDuration>30</muzzleVelDuration>
				<muzzleParticleSize>1.5</muzzleParticleSize>
				<muzzleSpawnDelay>1</muzzleSpawnDelay>
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>4</heatThreshold>
				<heatDecayRate>0.9</heatDecayRate>
				<decayIncrease>0.12</decayIncrease>
				<heatOffset>(0, 0, 1.5)</heatOffset>
				<heatEmissionRate>2</heatEmissionRate>
				<emissionIncrease>0.4</emissionIncrease>
				<heatParticleSize>0.6</heatParticleSize>
				<heatEmissionPoints>3</heatEmissionPoints>
				<heatEmissionSpacing>0.5</heatEmissionSpacing>
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>4</shockwaveRadius>
				<shockwaveDensity>40</shockwaveDensity>
				<shockwaveOffset>(0, 0, 4)</shockwaveOffset>
				<shockwaveParticleSize>1.5</shockwaveParticleSize>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_75mmLEIG18_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 8+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_75mmLEIG18</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension"> <!-- PLACEHOLDER: copied unadjusted, needs visual tuning (values from 152mmMsta) -->
			<barrelGraphic>
				<texPath>Things/Building/M75mmLEIG18_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>7.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>2</maxDistance>
				<recoilDuration>30</recoilDuration>
				<returnDuration>100</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<durationTicks>10</durationTicks>
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>
				<flashSize>30</flashSize>
				<flashBrightness>3.0</flashBrightness>
				<flashOffset>-1</flashOffset>
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>
					<li>(0.3, 0.9)</li>
					<li>(0.6, 0.6)</li>
					<li>(1, 0)</li>
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
    	<li Class="CombatExtended.NonSnapTurretExtension">
    		<speed>0.5</speed>
    		<preferedAngleRange>15</preferedAngleRange>
    		<minAngleWeight>0.1</minAngleWeight>
    	</li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_75mmLEIG18_Weapon</defName>
		<label>7.5 cm le.IG 18 Gun</label>
		<graphicData>
			<texPath>Things/Building/M75mmLEIG18_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 7.5 cm le.IG 18 was a German infantry support howitzer introduced in the 1930s. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: None, HP: 315, Reload: 6.0s, Range: 3550, Shelling Range: 6. Ammunition: 75mm Jgr. 18 (HE, Damage: 120, Explosion Radius: 2.5).</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.02</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_75mmLEIG18_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>5</minRange>
				<range>3550</range>
				<soundCast>Sound_75mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>6</reloadTime>
				<ammoSet>AmmoSet_75mmLEIG18_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

