<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 7.5 cm le.IG 18 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_75mmLEIG18</defName>
		<label>7.5 cm le.IG 18</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_75mmLEIG18_Base</defName>
		<label>7.5 cm le.IG 18</label>
    <description>The 7.5 cm le.IG 18 was a German infantry support howitzer introduced in the 1930s. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: None, HP: 315, Reload: 6.0s, Range: 3550, Shelling Range: 6. Ammunition: 75mm Jgr. 18 (HE, Damage: 120, Explosion Radius: 2.5).</description>
		<constructionSkillPrerequisite>2</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M75mmLEIG18</texPath>
			<drawSize>(7,7)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M75mmLEIG18_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>315</MaxHitPoints>
			<WorkToBuild>9000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>300</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>Turret_75mmLEIG18_Weapon</turretGunDef>
      <turretTopDrawSize>7</turretTopDrawSize>
			<turretBurstCooldownTime>0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_75mmLEIG18</designatorDropdown>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_EnclosedTurret">
				<explosiveProtection>0.3</explosiveProtection>   <!-- blast damage reduction (fragments go through the shield check instead) -->
				<flameProtection>0</flameProtection>             <!-- open top: no fire protection -->
				<meleeProtection>0</meleeProtection>             <!-- open top: no melee protection -->
				<generalProtection>0</generalProtection>           <!-- open top: no protection from unclassified damage -->
				<temperatureProtection>0</temperatureProtection> <!-- open top: no climate protection -->
				<hidePawnGraphics>false</hidePawnGraphics>
				<!-- Open-top seat & gun shield (placeholder values, tune in game) -->
				<seatOffset>(0,0,-0.9)</seatOffset>    <!-- turret-top frame: +Z along barrel, +X barrel's right -->
				<shieldArc>100</shieldArc>             <!-- front shield only -->
				<shieldHeight>0.75</shieldHeight>      <!-- shield top above ground (barrelHeight 1.0 - 0.25) -->
				<shieldArmor>8</shieldArmor>          <!-- mm RHA: stops 5.56 FMJ (CE 6) and 7.62 FMJ (7), not AP -->
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>3</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 1.4)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>20</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>15~25</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>3~4</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>2</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.2</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 1.2)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>3.5</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>1</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.2</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>3</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>30</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 1.4)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>1.5</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
				<shockwaveFadeOutSpeed>0.6</shockwaveFadeOutSpeed> <!-- fade out speed multiplier (1.0 = default) -->
				<shockwaveGradientDensity>false</shockwaveGradientDensity> <!-- gradient density (1.0 = 100% at center, 0.1 = 10% at edge) -->
				<shockwaveGradientParticleSize>true</shockwaveGradientParticleSize> <!-- gradient particle size (1.0 = 100% at center, 0.1 = 10% at edge) -->
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_75mmLEIG18_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 8+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>3,3</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_75mmLEIG18</li>
		</researchPrerequisites>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <modExtensions>
		<li Class="AbsolutelyMoreCannons.TurretBarrelExtension"> <!-- PLACEHOLDER: copied unadjusted, needs visual tuning (values from 152mmMsta) -->
			<barrelHeight>1.0</barrelHeight>
			<barrelGraphic>
				<texPath>Things/Building/M75mmLEIG18_Barrel</texPath>
				<graphicClass>Graphic_Single</graphicClass>
				<drawSize>(3,3)</drawSize>
			</barrelGraphic>
			<barrelOffset>(0,0,0.0)</barrelOffset>
			<barrelDrawSize>7.0</barrelDrawSize>
			<drawOnTop>false</drawOnTop>
			<barrelAmount>1</barrelAmount>
			<recoilAnimation>
				<maxDistance>0.4</maxDistance>
				<recoilDuration>20</recoilDuration>
				<returnDuration>20</returnDuration>
				<useRecoilCurve>true</useRecoilCurve>
				<useReturnCurve>false</useReturnCurve>
				<affectsRotation>false</affectsRotation>
			</recoilAnimation>
			<firingAnimation>
				<enabled>true</enabled>
				<projectileSpawnOffset>1.2</projectileSpawnOffset>
				<durationTicks>10</durationTicks>
				<drawFlash>true</drawFlash>
				<flashColor>(1,0.7,0.3,1)</flashColor>
				<flashSize>20</flashSize>
				<flashBrightness>3.0</flashBrightness>
				<flashOffset>-1.5</flashOffset>
				<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>
				<flashIntensityCurve>
					<points>
					<li>(0, 1)</li>
					<li>(0.3, 0.9)</li>
					<li>(0.6, 0.6)</li>
					<li>(1, 0)</li>
					</points>
				</flashIntensityCurve>
			</firingAnimation>
		</li>
    	<li Class="CombatExtended.NonSnapTurretExtension">
    		<speed>0.5</speed>
    		<preferedAngleRange>15</preferedAngleRange>
    		<minAngleWeight>0.1</minAngleWeight>
    	</li>
    </modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_75mmLEIG18_Weapon</defName>
		<label>7.5 cm le.IG 18 Gun</label>
		<graphicData>
			<texPath>Things/Building/M75mmLEIG18_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 7.5 cm le.IG 18 was a German infantry support howitzer introduced in the 1930s. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: None, HP: 315, Reload: 6.0s, Range: 3550, Shelling Range: 6. Ammunition: 75mm Jgr. 18 (HE, Damage: 120, Explosion Radius: 2.5).</description>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.02</ShotSpread>
			<SwayFactor>0.1</SwayFactor>
			<RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Interact</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_75mmLEIG18_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>5</minRange>
				<range>3550</range>
				<soundCast>Sound_75mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_75mmLEIG18_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

