<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase" Name="AMC_AutoloaderBase" Abstract="True">
		<description>Allows storing and automatically feeding designated ammunitions to nearby turrets.</description>
		<thingClass>CombatExtended.Building_AutoLoaderCE</thingClass>
		<tickerType>Normal</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.35</staticSunShadowHeight>
		<fillPercent>0.5</fillPercent>
		<canOverlapZones>false</canOverlapZones>
		<pathCost>42</pathCost>
		<building>
			<destroySound>BuildingDestroyed_Metal_Small</destroySound>
		</building>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToBuild>1800</WorkToBuild>
			<Mass>20</Mass>
			<Flammability>0.5</Flammability>
			<ReloadSpeed>5</ReloadSpeed>
		</statBases>
		<designationCategory>Security</designationCategory>
		<thingCategories Inherit="false"/>
	</ThingDef>

	<!-- Small Autoloader (20mm - 76mm) -->
	<ThingDef ParentName="AMC_AutoloaderBase">
		<defName>AMC_Autoloader_Small</defName>
		<label>Small Autoloader</label>
		<description>Allows storing and automatically feeding small-caliber ammunition (20mm - 76mm) to nearby turrets.</description>
		<size>(2,2)</size>
		<costList>
			<Steel>200</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToBuild>1800</WorkToBuild>
			<Mass>20</Mass>
			<Flammability>0.5</Flammability>
			<ReloadSpeed>5</ReloadSpeed>
		</statBases>
		
		<graphicData>
			<texPath>Things/Building/Autoloader/AutoloaderS</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(6,6)</drawSize>
		</graphicData>
		<designatorDropdown>Group_AMC_autoloaders</designatorDropdown>

		<comps>
			<li Class="CombatExtended.CompProperties_AmmoListUser">
				<magazineSize>6000</magazineSize>
				<reloadTime>9.2</reloadTime>
				<additionalAmmoSets />
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
			</li>
		</comps>

		<modExtensions>
			<li Class="CombatExtended.ModExtension_AutoLoaderGraphics">
				<fullGraphic>
					<texPath>Things/Building/Autoloader/AutoloaderS</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(6,6)</drawSize>
				</fullGraphic>
		
				<halfFullGraphic>
					<texPath>Things/Building/Autoloader/AutoloaderS</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(6,6)</drawSize>
				</halfFullGraphic>
		
				<emptyGraphic>
					<texPath>Things/Building/Autoloader/AutoloaderS</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(6,6)</drawSize>
				</emptyGraphic>

				<reloadingSustainer>AMC_AutoloaderS_loading</reloadingSustainer>
				<reloadCompleteSound>AMC_Turret_Small_Reload</reloadCompleteSound>
			</li>
		</modExtensions>
	</ThingDef>

