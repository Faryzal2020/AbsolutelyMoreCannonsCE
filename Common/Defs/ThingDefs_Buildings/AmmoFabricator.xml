<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>AMC_AmmoFabricator</defName>
    <label>AMC Automated Ammo Fabricator</label>
    <description>An automated ammunition manufacturing plant equipped with high-capacity internal material capacitors and unnecessarily intelligent AI.</description>
    <thingClass>Building</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/AUTOFABRICATOR</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(8,8)</drawSize>
      <drawOffset>(0,0,1.5)</drawOffset>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <costList>
      <Steel>500</Steel>
      <Plasteel>100</Plasteel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
      <AIPersonaCore>1</AIPersonaCore>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.85</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>12000</WorkToBuild>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <size>(7,4)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(2,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <inspectorTabs>
      <li>AbsolutelyMoreCannons.ITab_AmmoCapacitor</li>
      <li>AbsolutelyMoreCannons.ITab_AmmoCapacitorUpgrades</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>1200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(73,123,138,0)</glowColor>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="AbsolutelyMoreCannons.CompProperties_FabricatorEye">
        <eyeball>
          <texPath>Things/Building/AUTOFABRICATOR_EYEBALL</texPath>
          <scale>(0.08125,0.08125)</scale>
          <offset>(1.142,0,-2.267)</offset>
        </eyeball>
        <eyeballOff>
          <texPath>Things/Building/AUTOFABRICATOR_EYE_OFF</texPath>
          <scale>(0.08125,0.08125)</scale>
          <offset>(1.142,0,-2.267)</offset>
        </eyeballOff>
        <cover>
          <texPath>Things/Building/AUTOFABRICATOR_COVER</texPath>
          <scale>(1,1)</scale>
          <offset>(0,0,0)</offset>
        </cover>
        <glow>
          <texPath>Things/Building/AUTOFABRICATOR_GLOW</texPath>
          <scale>(0.2708,0.2688)</scale>
          <offset>(1.142,0,-2.267)</offset>
          <useGlowShader>true</useGlowShader>
        </glow>
        <topOff>
          <texPath>Things/Building/AUTOFABRICATOR_TOP_OFF</texPath>
          <scale>(1,1)</scale>
          <offset>(0,0,0)</offset>
        </topOff>
        <topOn>
          <texPath>Things/Building/AUTOFABRICATOR_TOP_ON</texPath>
          <scale>(1,1)</scale>
          <offset>(0,0,0)</offset>
        </topOn>
        <maxOffsetLeft>0.15</maxOffsetLeft>
        <maxOffsetRight>0.15</maxOffsetRight>
        <maxOffsetDown>0.50</maxOffsetDown>
        <maxOffsetUp>0.50</maxOffsetUp>
        <detectRadius>10</detectRadius>
        <onlyTrackInFront>true</onlyTrackInFront>
        <frontZMargin>1.0</frontZMargin>
        <trackSpeed>0.2</trackSpeed>
        <idleSpeed>0.20</idleSpeed>
        <idleHoldTicksMin>300</idleHoldTicksMin>
        <idleHoldTicksMax>600</idleHoldTicksMax>
        <trackSaccadeMagnitude>(0.04,0.09)</trackSaccadeMagnitude>
        <trackSaccadeIntervalMin>45</trackSaccadeIntervalMin>
        <trackSaccadeIntervalMax>180</trackSaccadeIntervalMax>
        <idleSaccadeMagnitude>(0.08,0.18)</idleSaccadeMagnitude>
        <idleSaccadeIntervalMin>45</idleSaccadeIntervalMin>
        <idleSaccadeIntervalMax>150</idleSaccadeIntervalMax>
        <ignorePawnCheckIntervalMin>300</ignorePawnCheckIntervalMin>
        <ignorePawnCheckIntervalMax>600</ignorePawnCheckIntervalMax>
        <ignorePawnChance>0.35</ignorePawnChance>
        <ignorePawnDurationMin>300</ignorePawnDurationMin>
        <ignorePawnDurationMax>600</ignorePawnDurationMax>
      </li>
      <li Class="AbsolutelyMoreCannons.CompProperties_FabricatorThoughts">
        <minIntervalTicks>720</minIntervalTicks>
        <maxIntervalTicks>1680</maxIntervalTicks>
        <bubbleDurationTicks>300</bubbleDurationTicks>
        <eventCooldownTicks>300</eventCooldownTicks>
        <bubbleWorldOffset>(0, 0, 0.95)</bubbleWorldOffset>
        <lowMaterialRatio>0.15</lowMaterialRatio>
        <fullStorageRatio>0.85</fullStorageRatio>
      </li>
      <li Class="AbsolutelyMoreCannons.CompProperties_AmmoCapacitor">
        <workSpeedFactor>4.0</workSpeedFactor>
        <outputCellOffset>(-2,0,-2)</outputCellOffset>
        <defaultStepSize>75</defaultStepSize>
        <baseMaxStorage>3000</baseMaxStorage>
        <materials>
          <!-- Projectile Materials (Base unit: 1 Steel = 1.0) -->
          <li>
            <thingDef>Steel</thingDef>
            <category>Projectile</category>
            <equivalenceValue>1.0</equivalenceValue>
            <canSubstitute>true</canSubstitute>
          </li>
          <li>
            <thingDef>Plasteel</thingDef>
            <category>Projectile</category>
            <equivalenceValue>4.0</equivalenceValue>
            <canSubstitute>true</canSubstitute>
          </li>
          <li>
            <thingDef>Uranium</thingDef>
            <category>Projectile</category>
            <equivalenceValue>3.0</equivalenceValue>
            <canSubstitute>true</canSubstitute>
          </li>
          <li>
            <thingDef>ComponentIndustrial</thingDef>
            <category>Projectile</category>
            <equivalenceValue>15.0</equivalenceValue>
            <canSubstitute>false</canSubstitute>
          </li>
          <li>
            <thingDef>ComponentSpacer</thingDef>
            <category>Projectile</category>
            <equivalenceValue>75.0</equivalenceValue>
            <canSubstitute>false</canSubstitute>
          </li>
          <li>
            <thingDef>Shell_AntigrainWarhead</thingDef>
            <category>Projectile</category>
            <equivalenceValue>0</equivalenceValue>
            <canSubstitute>false</canSubstitute>
          </li>

          <!-- Fuel Materials (Base unit: 1 FSX = 1.0) -->
          <li>
            <thingDef>FSX</thingDef>
            <category>Fuel</category>
            <equivalenceValue>1.0</equivalenceValue>
            <canSubstitute>true</canSubstitute>
          </li>
          <li>
            <thingDef>Chemfuel</thingDef>
            <category>Fuel</category>
            <equivalenceValue>0.25</equivalenceValue>
            <canSubstitute>true</canSubstitute>
          </li>
          <li>
            <thingDef>Prometheum</thingDef>
            <category>Fuel</category>
            <equivalenceValue>1.0</equivalenceValue>
            <canSubstitute>true</canSubstitute>
          </li>
        </materials>

        <!-- 4 Upgrade Levels configurable via XML -->
        <upgradeLevels>
          <li>
            <label>High-Torque Servo Drives</label>
            <speedMultiplier>1.25</speedMultiplier>
            <storageMultiplier>1.20</storageMultiplier>
            <rebateChance>0.05</rebateChance>
            <materialRebatePercent>0.10</materialRebatePercent>
            <workAmount>2000</workAmount>
            <minCraftingSkill>6</minCraftingSkill>
            <costList>
              <ComponentIndustrial>5</ComponentIndustrial>
            </costList>
          </li>
          <li>
            <label>Automated Scrap Reclamation</label>
            <speedMultiplier>1.50</speedMultiplier>
            <storageMultiplier>1.40</storageMultiplier>
            <rebateChance>0.10</rebateChance>
            <materialRebatePercent>0.15</materialRebatePercent>
            <workAmount>3500</workAmount>
            <minCraftingSkill>8</minCraftingSkill>
            <costList>
              <ComponentIndustrial>10</ComponentIndustrial>
              <Steel>200</Steel>
            </costList>
          </li>
          <li>
            <label>Precision Plasteel Press</label>
            <speedMultiplier>2.00</speedMultiplier>
            <storageMultiplier>1.70</storageMultiplier>
            <rebateChance>0.15</rebateChance>
            <materialRebatePercent>0.20</materialRebatePercent>
            <workAmount>5000</workAmount>
            <minCraftingSkill>10</minCraftingSkill>
            <costList>
              <ComponentIndustrial>15</ComponentIndustrial>
              <Plasteel>100</Plasteel>
              <ComponentSpacer>2</ComponentSpacer>
            </costList>
          </li>
          <li>
            <label>Hyper-Parallel Assembly Core</label>
            <speedMultiplier>2.75</speedMultiplier>
            <storageMultiplier>2.00</storageMultiplier>
            <rebateChance>0.25</rebateChance>
            <materialRebatePercent>0.25</materialRebatePercent>
            <workAmount>7500</workAmount>
            <minCraftingSkill>12</minCraftingSkill>
            <costList>
              <Plasteel>250</Plasteel>
              <ComponentSpacer>6</ComponentSpacer>
            </costList>
          </li>
        </upgradeLevels>
      </li>
    </comps>
    <tradeability>Buyable</tradeability>
    <building>
      <heatPerTickWhileWorking>0.3</heatPerTickWhileWorking>
    </building>
    <researchPrerequisites>
      <li>AMC_AmmoFabricator</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

</Defs>
