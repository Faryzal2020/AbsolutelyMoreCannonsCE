<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== OTO Melara 76/62C ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_76mmOtomelaraC</defName>
		<label>OTO Melara 76/62C</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> 
		<defName>Turret_76mmOtomelaraC_Base</defName>
		<label>OTO Melara 76/62C</label>
    	<description>The OTO Melara 76/62C was an Italian rapid-fire naval gun designed for multi-role surface and air targets. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 200, HP: 720, Cooldown: 2.5s, Range: 7-14000, Rate of Fire: 24 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 2.5m explosion radius and AP shell with 60 penetration.</description>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M76mmOtomelaraC</texPath>
			<drawSize>(15,15)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M76mmOtomelaraC_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2000</MaxHitPoints>
			<WorkToBuild>22500</WorkToBuild>
			<Mass>30</Mass>
			<Bulk>200</Bulk>
		</statBases>
		<costList>
			<Steel>1000</Steel>
			<ComponentIndustrial>45</ComponentIndustrial>
			<Plasteel>100</Plasteel>
			<ComponentSpacer>10</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_76mmOtomelaraC_Weapon</turretGunDef>
      		<turretTopDrawSize>14</turretTopDrawSize>
			<turretBurstCooldownTime>2</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<fillPercent>2.0</fillPercent>
		<designatorDropdown>Group_AMC_76mmOtomelaraC</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>900</basePowerConsumption>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretPreserveAmmo" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_76mmOtomelaraC_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretViewTransfer">
				<transferViewOrigin>true</transferViewOrigin>
				<ignoreSelfOcclusion>true</ignoreSelfOcclusion>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 5)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>40</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>1~2</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>2</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.24</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 3)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>3.5</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>4</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>4</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>40</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 4)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>1.5</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>5,5</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_76mmOtomelaraC</li>
		</researchPrerequisites>
    	<interactionCellOffset>(1,0,-3)</interactionCellOffset>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/M76mmOtomelaraC_Barrel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>14</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<recoilAnimation>
					<maxDistance>0.4</maxDistance>
					<recoilDuration>10</recoilDuration>
					<returnDuration>10</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>5</projectileSpawnOffset>
					<durationTicks>10</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
					<flashSize>30</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-1</flashOffset>  <!-- Offset from barrel tip -->
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
					<flashIntensityCurve>
						<points>
						<li>(0, 1)</li>      <!-- Full brightness at start -->
						<li>(0.3, 0.9)</li>  <!-- Still bright -->
						<li>(0.6, 0.6)</li>  <!-- Fading -->
						<li>(1, 0)</li>      <!-- Faded out -->
						</points>
					</flashIntensityCurve>
				</firingAnimation>
				<selectableBurstCounts>
					<li>1</li>
					<li>3</li>
					<li>6</li>
				</selectableBurstCounts>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretSuppressionImmunityExtension">
				<preventOperatorSuppression>true</preventOperatorSuppression>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretTrackingExtension">
				<enableMidBurstTracking>true</enableMidBurstTracking>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_76mmOtomelaraC_Weapon</defName>
		<label>OTO Melara 76/62C Gun</label>
		<graphicData>
			<texPath>Things/Building/M76mmOtomelaraC_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The OTO Melara 76/62C was an Italian rapid-fire naval gun designed for multi-role surface and air targets. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 200, HP: 5000, Cooldown: 2.5s, Range: 7-14000, Rate of Fire: 24 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 2.5m explosion radius and AP shell with 60 penetration.</description>
		<statBases>
			<SightsEfficiency>5</SightsEfficiency>
			<ShotSpread>0.005</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_76mmOtomelaraC_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>7</minRange>
				<range>16000</range>
				<soundCast>Sound_76mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>42</ticksBetweenBurstShots>
				<burstShotCount>3</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>200</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_76mmOtomelaraC_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

<!-- INDIRECT -->
	<ThingDef ParentName="AMCArtilleryBase">
		<defName>Turret_76mmOtomelaraC_indirect_Base</defName>
		<label>OTO Melara 76/62C (indirect)</label>
    	<description>The OTO Melara 76/62C was an Italian rapid-fire naval gun designed for multi-role surface and air targets. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 200, HP: 5000, Cooldown: 2.5s, Range: 7-14000, Rate of Fire: 24 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 2.5m explosion radius and AP shell with 60 penetration.</description>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M76mmOtomelaraC</texPath>
			<drawSize>(15,15)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M76mmOtomelaraC_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2000</MaxHitPoints>
			<WorkToBuild>22500</WorkToBuild>
			<Mass>30</Mass>
			<Bulk>200</Bulk>
		</statBases>
		<costList>
			<Steel>1000</Steel>
			<ComponentIndustrial>45</ComponentIndustrial>
			<Plasteel>100</Plasteel>
			<ComponentSpacer>10</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_76mmOtomelaraC_indirect_Weapon</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretBurstCooldownTime>2</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
      		<turretTopDrawSize>14</turretTopDrawSize>
		</building>
		<fillPercent>2.0</fillPercent>
		<designatorDropdown>Group_AMC_76mmOtomelaraC</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>900</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0</swayReduction>
				<recoilReduction>0</recoilReduction>
				<spreadReduction>1.1</spreadReduction>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretPreserveAmmo" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_76mmOtomelaraC_Base</alternateDef>
				<gizmoLabel>Switch to Direct Fire</gizmoLabel>
				<gizmoDesc>Change this turret into direct fire mode (flat trajectory)\nRequires line of sight, higher accuracy</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretViewTransfer">
				<transferViewOrigin>true</transferViewOrigin>
				<ignoreSelfOcclusion>true</ignoreSelfOcclusion>
			</li>
		</comps>
    	<size>(3,3)</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_76mmOtomelaraC</li>
		</researchPrerequisites>
    	<interactionCellOffset>(1,0,-3)</interactionCellOffset>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<selectableBurstCounts>
				<li>1</li>
				<li>3</li>
				<li>6</li>
			</selectableBurstCounts>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretSuppressionImmunityExtension">
				<preventOperatorSuppression>true</preventOperatorSuppression>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretTrackingExtension">
				<enableMidBurstTracking>true</enableMidBurstTracking>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_76mmOtomelaraC_indirect_Weapon</defName>
		<label>OTO Melara 76/62C Gun</label>
		<graphicData>
			<texPath>Things/Building/M76mmOtomelaraC_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The OTO Melara 76/62C was an Italian rapid-fire naval gun designed for multi-role surface and air targets. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 200, HP: 5000, Cooldown: 2.5s, Range: 7-14000, Rate of Fire: 24 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 2.5m explosion radius and AP shell with 60 penetration.</description>
		<statBases>
			<SightsEfficiency>5</SightsEfficiency>
			<ShotSpread>0.005</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<recoilAmount>1.5</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_76mmOtomelaraC_indirect_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        		<minRange>25</minRange>
				<range>16000</range>
				<soundCast>Sound_76mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
				<targetParams>
				<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>42</ticksBetweenBurstShots>
				<burstShotCount>3</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>1</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
					<li>70</li>
					<li>80</li>
					<li>90</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>200</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_76mmOtomelaraC_indirect_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretChargeBoostExtension">
				<chargeOffset>1</chargeOffset>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>