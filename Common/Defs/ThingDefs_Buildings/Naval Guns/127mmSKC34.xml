	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_127mmSKC34_indirect_Weapon</defName>
		<label>12.7cm SK C/34 Gun</label>
		<graphicData>
			<texPath>Things/Building/M127mmSKC34_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 12.7cm SK C/34 was developed as a German naval gun for destroyers during WWII. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 300, HP: 5500, Cooldown: 4.0s, Range: 7-17000, Rate of Fire: 15 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 3.0m explosion radius.</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>4</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<recoilAmount>1.5</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmSKC34_indirect_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>60</minRange>
				<range>17000</range>
				<soundCast>Sound_Single127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>1</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>50</li>
					<li>75</li>
					<li>100</li>
					<li>125</li>
					<li>150</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_127mmSKC34_indirect_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>
	
</Defs>