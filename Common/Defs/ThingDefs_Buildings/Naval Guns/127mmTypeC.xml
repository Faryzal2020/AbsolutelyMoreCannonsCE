<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 12.7cm 3rd Year Type C ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_127mmTypeC</defName>
		<label>12.7cm 3rd Year Type C</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase">
		<defName>Turret_127mmTypeC_Base</defName>
		<label>12.7cm 3rd Year Type C</label>
		<description>The 12.7cm 3rd Year Type C was a Japanese naval twin gun mounted on destroyers and cruisers. It fires twin-gun salvos, has an indirect fire variant, and is capable of settlement bombardment. Power: 400, HP: 1440, Cooldown: 12.0s, Range: 7-14800, Rate of Fire: 10 rounds per minute, Aimed Burst: 2, Reload Time: 1s. Ammunition: HE shell with 3.0m explosion radius.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M127mmTypeC</texPath>
			<drawSize>(15,15)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M127mmTypeC_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>1440</MaxHitPoints>
			<WorkToBuild>41500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>1200</Steel>
			<ComponentIndustrial>20</ComponentIndustrial>
			<Plasteel>60</Plasteel>
			<ComponentSpacer>5</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_127mmTypeC_Weapon</turretGunDef>
			<turretTopDrawSize>15</turretTopDrawSize>
			<turretBurstCooldownTime>12.0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<fillPercent>2.0</fillPercent>
		<designatorDropdown>Group_AMC_127mmTypeC</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>400</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretPreserveAmmo" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_127mmTypeC_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.1</swayReduction>
				<recoilReduction>0.1</recoilReduction>
				<spreadReduction>0.1</spreadReduction>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretViewTransfer">
				<transferViewOrigin>true</transferViewOrigin>
				<ignoreSelfOcclusion>true</ignoreSelfOcclusion>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>3</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration>
				<muzzleOffset>(0, 0, 4.5)</muzzleOffset>
				<muzzleVelocity>15</muzzleVelocity>
				<muzzleVelDuration>40</muzzleVelDuration>
				<directionCone>4</directionCone>
				<muzzleParticleSize>1.5~2.2</muzzleParticleSize>
				<muzzleSpawnDelay>1</muzzleSpawnDelay>
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>15</heatThreshold>
				<heatDecayRate>0.48</heatDecayRate>
				<decayIncrease>0.08</decayIncrease>
				<heatOffset>(0, 0, 2)</heatOffset>
				<heatEmissionRate>3.5</heatEmissionRate>
				<emissionIncrease>0.9</emissionIncrease>
				<heatParticleSize>0.6</heatParticleSize>
				<heatEmissionPoints>3</heatEmissionPoints>
				<heatEmissionSpacing>0.4</heatEmissionSpacing>
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>4.5</shockwaveRadius>
				<shockwaveDensity>50</shockwaveDensity>
				<shockwaveOffset>(0, 0, 4.5)</shockwaveOffset>
				<shockwaveParticleSize>1.5</shockwaveParticleSize>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<size>(6,6)</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_127mmTypeC</li>
		</researchPrerequisites>
    	<interactionCellOffset>(2,0,-3)</interactionCellOffset>
		<modExtensions>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.35</speed>
				<preferedAngleRange>30</preferedAngleRange>
				<angleWeightMultiplier>1.5</angleWeightMultiplier>
				<minAngleWeight>0.1</minAngleWeight>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/M127mmTypeC_Barrel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>15.0</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<barrelAmount>2</barrelAmount>
				<barrelSpacing>2</barrelSpacing>
				<sequentialFiring>true</sequentialFiring>
				<recoilAnimation>
					<maxDistance>0.3</maxDistance>
					<recoilDuration>15</recoilDuration>
					<returnDuration>30</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>4.5</projectileSpawnOffset>
					<durationTicks>10</durationTicks>
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>
					<flashSize>25</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-1</flashOffset>
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>
					<flashIntensityCurve>
						<points>
							<li>(0, 1)</li>
							<li>(0.3, 0.9)</li>
							<li>(0.6, 0.6)</li>
							<li>(1, 0)</li>
						</points>
					</flashIntensityCurve>
				</firingAnimation>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretSuppressionImmunityExtension">
				<preventOperatorSuppression>true</preventOperatorSuppression>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretTrackingExtension">
				<enableMidBurstTracking>true</enableMidBurstTracking>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_127mmTypeC_Weapon</defName>
		<label>12.7cm 3rd Year Type C Gun</label>
		<graphicData>
			<texPath>Things/Building/M127mmTypeC_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 12.7cm 3rd Year Type C was a Japanese naval twin gun mounted on destroyers and cruisers. It fires twin-gun salvos, has an indirect fire variant, and is capable of settlement bombardment. Power: 400, HP: 1440, Cooldown: 12.0s, Range: 7-14800, Rate of Fire: 10 rounds per minute, Aimed Burst: 2, Reload Time: 1s. Ammunition: HE shell with 3.0m explosion radius.</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>12.0</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmTypeC_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<minRange>7</minRange>
				<range>14800</range>
				<soundCast>Sound_Double127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
				<burstShotCount>2</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>80</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_127mmTypeC_Shells</ammoSet>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretClampingExtension">
				<maxVerticalDeviation>2</maxVerticalDeviation>
				<maxRotationDeviation>2</maxRotationDeviation>
			</li>
		</modExtensions>
	</ThingDef>

<!-- INDIRECT -->
	<ThingDef ParentName="AMCArtilleryBase">
