	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_127mmTypeC_indirect_Weapon</defName>
		<label>12.7cm 3rd Year Type C Gun</label>
		<graphicData>
			<texPath>Things/Building/M127mmTypeC_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 12.7cm 3rd Year Type C was a Japanese naval gun mounted on destroyers and light cruisers. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 300, HP: 5500, Cooldown: 4.0s, Range: 7-17000, Rate of Fire: 15 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 3.0m explosion radius.</description>
		<statBases>
