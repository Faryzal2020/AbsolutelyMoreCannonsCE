					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<underBarrelGraphic>
					<texPath>Things/Building/M127mmTypeC_UnderBarrel_Indirect</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</underBarrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
