<?xml version='1.0' encoding='utf-8'?>
<Defs>
									
	

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_120mmTAK120</defName>
		<label>12cm/46 TAK120</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> 
		<defName>Turret_120mmTAK120_Base</defName>
		<label>12cm/46 TAK120</label>
    	<description>Manned: Yes, Indirect fire: Available, Power: 800W, HP: 1680, Cooldown: 2.0s, Range: 8-18000, Rate of Fire: 30 rounds per minute, Burst Count: 6, Magazine: 52, Reload: 1.0s. A formidable Swedish coastal defense piece.</description>
		<constructionSkillPrerequisite>7</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M120mmTAK120</texPath>
			<drawSize>(25,25)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M120mmTAK120_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>1680</MaxHitPoints>
			<WorkToBuild>35000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>1100</Steel>
      		<ComponentIndustrial>40</ComponentIndustrial>
			<Plasteel>50</Plasteel>
      		<ComponentSpacer>10</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_120mmTAK120_Weapon</turretGunDef>
			<turretTopDrawSize>15</turretTopDrawSize>
			<turretBurstCooldownTime>2</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_120mmTAK120</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>800</basePowerConsumption>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_120mmTAK120_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.1</swayReduction>
				<recoilReduction>0.1</recoilReduction>
				<spreadReduction>0.1</spreadReduction>
			</li>
			
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> 
				<muzzleOffset>(0, 0, 6.5)</muzzleOffset> 
				<muzzleVelocity>15</muzzleVelocity> 
				<muzzleVelDuration>40</muzzleVelDuration> 
				<directionCone>4</directionCone>
				<muzzleParticleSize>1~2</muzzleParticleSize> 
				<muzzleSpawnDelay>1</muzzleSpawnDelay> 
				
				
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>20</heatThreshold> 
				<heatDecayRate>0.48</heatDecayRate> 
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 3)</heatOffset> 

				<heatEmissionRate>3.5</heatEmissionRate> 
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> 
				<heatEmissionPoints>4</heatEmissionPoints> 
				<heatEmissionSpacing>0.5</heatEmissionSpacing> 
				
				
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>5</shockwaveRadius> 
				<shockwaveDensity>50</shockwaveDensity> 
				<shockwaveOffset>(0, 0, 7)</shockwaveOffset> 
				<shockwaveParticleSize>1.5</shockwaveParticleSize> 
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>5,5</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_120mmTAK120</li>
		</researchPrerequisites>
    	<interactionCellOffset>(2,0,-3)</interactionCellOffset>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/M120mmTAK120_Barrel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>15.0</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<recoilAnimation>
					<maxDistance>0.3</maxDistance>
					<recoilDuration>15</recoilDuration>
					<returnDuration>30</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>5.5</projectileSpawnOffset>
					<durationTicks>10</durationTicks>  
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>  
					<flashSize>30</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-1</flashOffset>  
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  
					<flashIntensityCurve>
						<points>
						<li>(0, 1)</li>      
						<li>(0.3, 0.9)</li>  
						<li>(0.6, 0.6)</li>  
						<li>(1, 0)</li>      
						</points>
					</flashIntensityCurve>
				</firingAnimation>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_120mmTAK120_Weapon</defName>
		<label>12cm/46 TAK120 Gun</label>
		<graphicData>
			<texPath>Things/Building/M120mmTAK120_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 12cm/46 TAK120 was a Swedish naval gun designed for coastal defense and surface action. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 6000, Cooldown: 5.0s, Range: 7-17000, Rate of Fire: 12 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 3.5m explosion radius and AP shell with 190 penetration.</description>
		<statBases>
			<SightsEfficiency>5</SightsEfficiency>
			<ShotSpread>0.005</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.2</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_120mmTAK120_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<minRange>8</minRange>
				<range>18000</range>
				<soundCast>Sound_120mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>45</ticksBetweenBurstShots>
				<burstShotCount>6</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>52</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_120mmTAK120_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>


