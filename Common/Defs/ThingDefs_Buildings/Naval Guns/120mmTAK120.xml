	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_120mmTAK120_indirect_Weapon</defName>
		<label>12cm/46 TAK120 Gun</label>
		<graphicData>
			<texPath>Things/Building/M120mmTAK120_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 12cm/46 TAK120 was a Swedish naval gun designed for coastal defense and surface action. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 6000, Cooldown: 5.0s, Range: 7-17000, Rate of Fire: 12 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 3.5m explosion radius and AP shell with 190 penetration.</description>
		<statBases>
			<SightsEfficiency>5</SightsEfficiency>
			<ShotSpread>0.005</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<recoilAmount>0</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_120mmTAK120_indirect_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>25</minRange>
				<range>18000</range>
				<soundCast>Sound_120mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>45</ticksBetweenBurstShots>
				<burstShotCount>6</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<requireLineOfSight>false</requireLineOfSight>
				<circularError>1</circularError>
				<indirectFirePenalty>0.125</indirectFirePenalty>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
			</li>
		</verbs>
		<comps>
