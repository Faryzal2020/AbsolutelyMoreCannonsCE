	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>Turret_100mmModel1953_indirect_Weapon</defName>
		<label>10cm/55 Model 1953 Gun</label>
		<graphicData>
			<texPath>Things/Building/M100mmModel1953_Top_Indirect</texPath>
			<graphicClass>Graphic_Single</graphicClass>
