<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 10cm/55 Model 1953 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_100mmModel1953</defName>
		<label>100mm Creusot-Loire</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_100mmModel1953_Base</defName>
		<label>100mm Creusot-Loire</label>
    	<description>The 100mm Creusot-Loire was a French dual-purpose naval gun designed for frigates and destroyers. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 250, HP: 2250, Cooldown: 3.5s, Range: 7-16000, Rate of Fire: 17 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 2.5m explosion radius.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M100mmModel1953</texPath>
			<drawSize>(15,15)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M100mmModel1953_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2250</MaxHitPoints>
			<WorkToBuild>31500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>1000</Steel>
      		<ComponentIndustrial>30</ComponentIndustrial>
			<Plasteel>50</Plasteel>
      		<ComponentSpacer>8</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_100mmModel1953_Weapon</turretGunDef>
      		<turretTopDrawSize>10</turretTopDrawSize>
			<turretBurstCooldownTime>1</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<fillPercent>2.0</fillPercent>
		<designatorDropdown>Group_AMC_100mmModel1953</designatorDropdown>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_TracerLine">
				<lineLength>25.0</lineLength>
				<lineWidth>0.06</lineWidth>
				<lineOffset>(0, 0, 1.8)</lineOffset>
				<durationTicks>2</durationTicks>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>800</basePowerConsumption>
			</li>
      		<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_100mmModel1953_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.1</swayReduction>
				<recoilReduction>0.1</recoilReduction>
				<spreadReduction>0.1</spreadReduction>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretViewTransfer">
				<transferViewOrigin>true</transferViewOrigin>
				<ignoreSelfOcclusion>true</ignoreSelfOcclusion>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>3</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration> <!-- ticks to spread out particle spawning -->
				<muzzleOffset>(0, 0, 5)</muzzleOffset> <!-- offset in cells (x, y, z) from turret center -->
				<muzzleVelocity>15</muzzleVelocity> <!-- cells per second initial velocity -->
				<muzzleVelDuration>20~30</muzzleVelDuration> <!-- ticks for directional motion before transitioning to wind -->
				<directionCone>4</directionCone>
				<muzzleParticleSize>3~4</muzzleParticleSize> <!-- size multiplier (1.0 = default) -->
				<muzzleSpawnDelay>1</muzzleSpawnDelay> <!-- ticks to delay spawn after firing -->
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>12</heatThreshold> <!-- shots required to start emitting heat smoke -->
				<heatDecayRate>0.24</heatDecayRate> <!-- heat loss per second -->
				<decayIncrease>0.08</decayIncrease>

				<heatOffset>(0, 0, 2)</heatOffset> <!-- offset in cells (x, y, z) from turret center -->

				<heatEmissionRate>3.5</heatEmissionRate> <!-- particles per second while above threshold -->
				<emissionIncrease>0.9</emissionIncrease>

				<heatParticleSize>0.6</heatParticleSize> <!-- size multiplier (1.0 = default) -->
				<heatEmissionPoints>4</heatEmissionPoints> <!-- number of emission points along barrel -->
				<heatEmissionSpacing>0.5</heatEmissionSpacing> <!-- distance between points in cells -->
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>4</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>50</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 5)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>2</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
				<shockwaveFadeOutSpeed>0.6</shockwaveFadeOutSpeed> <!-- fade out speed multiplier (1.0 = default) -->
				<shockwaveGradientDensity>false</shockwaveGradientDensity> <!-- gradient density (1.0 = 100% at center, 0.1 = 10% at edge) -->
				<shockwaveGradientParticleSize>true</shockwaveGradientParticleSize> <!-- gradient particle size (1.0 = 100% at center, 0.1 = 10% at edge) -->
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    	<size>5,5</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_100mmModel1953</li>
		</researchPrerequisites>
		<interactionCellOffset>(1,0,-3)</interactionCellOffset>
		<modExtensions>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<!-- Turn speed in degrees per tick (e.g. 0.5 = 30°/sec, 1.0 = 60°/sec, 2.0 = 120°/sec) -->
				<speed>0.4</speed> 
				<!-- Angle range (in degrees) preferred for target selection -->
				<preferedAngleRange>30</preferedAngleRange>
				<!-- Multiplier for angle weighting in target scoring -->
				<angleWeightMultiplier>1.5</angleWeightMultiplier>
				<!-- Minimum weight divisor to prevent division by zero -->
				<minAngleWeight>0.1</minAngleWeight>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/M100mmModel1953_Barrel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>10.0</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<recoilAnimation>
					<maxDistance>0.5</maxDistance>
					<recoilDuration>15</recoilDuration>
					<returnDuration>30</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>5.5</projectileSpawnOffset>
					<durationTicks>10</durationTicks>  <!-- 2 seconds (120 ticks) for debugging -->
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>  <!-- Orange/yellow -->
					<flashSize>30</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-1</flashOffset>  <!-- Offset from barrel tip -->
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>  <!-- Optional EffecterDef for muzzle flash -->
					<flashIntensityCurve>
						<points>
						<li>(0, 1)</li>      <!-- Full brightness at start -->
						<li>(0.3, 0.9)</li>  <!-- Still bright -->
						<li>(0.6, 0.6)</li>  <!-- Fading -->
						<li>(1, 0)</li>      <!-- Faded out -->
						</points>
					</flashIntensityCurve>
				</firingAnimation>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretSuppressionImmunityExtension">
				<preventOperatorSuppression>true</preventOperatorSuppression>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretTrackingExtension">
				<enableMidBurstTracking>true</enableMidBurstTracking>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_100mmModel1953_Weapon</defName>
		<label>10cm/55 Model 1953 Gun</label>
		<graphicData>
			<texPath>Things/Building/M100mmModel1953_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 100mm Creusot-Loire was a French dual-purpose naval gun designed for frigates and destroyers. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 250, HP: 5500, Cooldown: 3.5s, Range: 7-16000, Rate of Fire: 17 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 2.5m explosion radius.</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.2</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_100mmModel1953_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>7</minRange>
				<range>19500</range>
				<soundCast>Sound_Naval100mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>70</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>100</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_100mmModel1953_Shells</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
				<aimedBurstShotCount>1</aimedBurstShotCount>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretClampingExtension">
				<maxVerticalDeviation>2</maxVerticalDeviation>
				<maxRotationDeviation>2</maxRotationDeviation>
			</li>
		</modExtensions>
	</ThingDef>

