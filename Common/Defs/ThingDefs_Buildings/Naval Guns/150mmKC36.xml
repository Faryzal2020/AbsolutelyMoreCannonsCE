<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 15cm Tbts KC/36 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_150mmKC36</defName>
		<label>15cm Tbts KC/36</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_150mmKC36_Base</defName>
		<label>15cm Tbts KC/36</label>
    <description>The 15cm Tbts KC/36 was a German WWII destroyer gun designed for shore bombardment and naval warfare. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 500, HP: 2240, Cooldown: 6.0s, Range: 7-20000, Rate of Fire: 10 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 4.0m explosion radius.</description>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M150mmKC36</texPath>
			<drawSize>(15,15)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M150mmKC36_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>2240</MaxHitPoints>
			<WorkToBuild>60000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>1100</Steel>
      <ComponentIndustrial>15</ComponentIndustrial>
			<Plasteel>40</Plasteel>
      <ComponentSpacer>5</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_150mmKC36_Weapon</turretGunDef>
      <turretTopDrawSize>15</turretTopDrawSize>
			<turretBurstCooldownTime>8</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_150mmKC36</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_150mmKC36</li>
		</researchPrerequisites>
    <interactionCellOffset>(2,0,-2)</interactionCellOffset>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_150mmKC36_Weapon</defName>
		<label>15cm Tbts KC/36 Gun</label>
		<graphicData>
			<texPath>Things/Building/M150mmKC36_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 15cm Tbts KC/36 was a German WWII destroyer gun designed for shore bombardment and naval warfare. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 500, HP: 6000, Cooldown: 6.0s, Range: 7-20000, Rate of Fire: 10 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 4.0m explosion radius.</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>8</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_150mmKC36_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>8</minRange>
				<range>23000</range>
				<soundCast>Sound_Naval150mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>120</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
		    	<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_150mmKC36_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

