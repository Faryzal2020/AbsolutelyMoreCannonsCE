<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== Otobreda 127/54C ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_127mmOtobredaC</defName>
		<label>Otobreda 127/54C</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase">
		<defName>Turret_127mmOtobredaC_Base</defName>
		<label>Otobreda 127/54C</label>
		<description>The Otobreda 127/54C was an Italian rapid-fire naval gun developed for surface combat and shore bombardment. Equipped with an automatic drum autoloader, it features selectable burst fire, an indirect fire variant, and is capable of settlement bombardment. Power: 700, HP: 1440, Cooldown: 2.0s, Range: 7-30000, Rate of Fire: 45 rounds per minute, Aimed Burst: 3, Reload Time: 1s. Ammunition: AP shell with 150 penetration and HE shell with 3.5m explosion radius.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M127mmOtobredaC</texPath>
			<drawSize>(15,15)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M127mmOtobredaC_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>1440</MaxHitPoints>
			<WorkToBuild>41500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>1000</Steel>
			<ComponentIndustrial>25</ComponentIndustrial>
			<Plasteel>40</Plasteel>
			<ComponentSpacer>5</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_127mmOtobredaC_Weapon</turretGunDef>
			<turretTopDrawSize>13</turretTopDrawSize>
			<turretBurstCooldownTime>2.0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<fillPercent>2.0</fillPercent>
		<designatorDropdown>Group_AMC_127mmOtobredaC</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>700</basePowerConsumption>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretBarrel" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretPreserveAmmo" />
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretModeSwap">
				<alternateDef>Turret_127mmOtobredaC_indirect_Base</alternateDef>
				<gizmoLabel>Switch to Indirect Fire</gizmoLabel>
				<gizmoDesc>Change this turret into indirect fire mode (artillery arc)\nRequires 25+ cell range, fires over obstacles</gizmoDesc>
				<gizmoIcon>UI/Buttons/ArtyMode</gizmoIcon>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_AccuracyOverride">
				<swayReduction>0.1</swayReduction>
				<recoilReduction>0.1</recoilReduction>
				<spreadReduction>0.1</spreadReduction>
			</li>
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretViewTransfer">
				<transferViewOrigin>true</transferViewOrigin>
				<ignoreSelfOcclusion>true</ignoreSelfOcclusion>
			</li>
			<!-- Smoke Effects -->
			<li Class="AbsolutelyMoreCannons.CompProperties_TurretSmoker">
				<!-- Muzzle Smoke -->
				<muzzleEnabled>true</muzzleEnabled>
				<muzzleFleckDef>AMC_MuzzleSmoke</muzzleFleckDef>
				<muzzleParticleCount>2</muzzleParticleCount>
				<muzzleSpawnDuration>5</muzzleSpawnDuration>
				<muzzleOffset>(0, 0, 5)</muzzleOffset>
				<muzzleVelocity>15</muzzleVelocity>
				<muzzleVelDuration>40</muzzleVelDuration>
				<directionCone>4</directionCone>
				<muzzleParticleSize>1~2</muzzleParticleSize>
				<muzzleSpawnDelay>1</muzzleSpawnDelay>
				
				<!-- Heat Smoke -->
				<heatEnabled>true</heatEnabled>
				<heatFleckDef>AMC_HeatSmoke</heatFleckDef>
				<heatThreshold>20</heatThreshold>
				<heatDecayRate>0.48</heatDecayRate>
				<decayIncrease>0.08</decayIncrease>
				<heatOffset>(0, 0, 3)</heatOffset>
				<heatEmissionRate>3.5</heatEmissionRate>
				<emissionIncrease>0.9</emissionIncrease>
				<heatParticleSize>0.6</heatParticleSize>
				<heatEmissionPoints>3</heatEmissionPoints>
				<heatEmissionSpacing>0.5</heatEmissionSpacing>
				
				<!-- Shockwave Smoke -->
				<shockwaveEnabled>true</shockwaveEnabled>
				<shockwaveFleckDef>AMC_ShockwaveSmoke</shockwaveFleckDef>
				<shockwaveRadius>5</shockwaveRadius> <!-- radius in cells -->
				<shockwaveDensity>70</shockwaveDensity> <!-- number of particles in the ring -->
				<shockwaveOffset>(0, 0, 7)</shockwaveOffset> <!-- offset in cells (x, y, z) from turret center -->
				<shockwaveParticleSize>2</shockwaveParticleSize> <!-- size multiplier (1.0 = default) -->
				<shockwaveFadeOutSpeed>0.5</shockwaveFadeOutSpeed> <!-- fade out speed multiplier (1.0 = default) -->
				<shockwaveGradientDensity>false</shockwaveGradientDensity> <!-- gradient density (1.0 = 100% at center, 0.1 = 10% at edge) -->
				<shockwaveGradientParticleSize>true</shockwaveGradientParticleSize> <!-- gradient particle size (1.0 = 100% at center, 0.1 = 10% at edge) -->
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<size>(6,6)</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_127mmOtobredaC</li>
		</researchPrerequisites>
		<interactionCellOffset>(2,0,-3)</interactionCellOffset>
		<modExtensions>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.5</speed>
				<preferedAngleRange>30</preferedAngleRange>
				<angleWeightMultiplier>1.5</angleWeightMultiplier>
				<minAngleWeight>0.1</minAngleWeight>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretBarrelExtension">
				<barrelGraphic>
					<texPath>Things/Building/M127mmOtobredaC_Barrel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(3,3)</drawSize>
				</barrelGraphic>
				<barrelOffset>(0,0,0.0)</barrelOffset>
				<barrelDrawSize>13.0</barrelDrawSize>
				<drawOnTop>false</drawOnTop>
				<recoilAnimation>
					<maxDistance>0.3</maxDistance>
					<recoilDuration>12</recoilDuration>
					<returnDuration>24</returnDuration>
					<useRecoilCurve>true</useRecoilCurve>
					<useReturnCurve>false</useReturnCurve>
					<affectsRotation>false</affectsRotation>
				</recoilAnimation>
				<firingAnimation>
					<enabled>true</enabled>
					<projectileSpawnOffset>5.0</projectileSpawnOffset>
					<durationTicks>10</durationTicks>
					<drawFlash>true</drawFlash>
					<flashColor>(1,0.7,0.3,1)</flashColor>
					<flashSize>30</flashSize>
					<flashBrightness>2.0</flashBrightness>
					<flashOffset>-1</flashOffset>
					<muzzleFlashEffect>AMC_MuzzleFlashLight</muzzleFlashEffect>
					<flashIntensityCurve>
						<points>
							<li>(0, 1)</li>
							<li>(0.3, 0.9)</li>
							<li>(0.6, 0.6)</li>
							<li>(1, 0)</li>
						</points>
					</flashIntensityCurve>
				</firingAnimation>
				<selectableBurstCounts>
					<li>1</li>
					<li>3</li>
					<li>6</li>
				</selectableBurstCounts>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretSuppressionImmunityExtension">
				<preventOperatorSuppression>true</preventOperatorSuppression>
			</li>
			<li Class="AbsolutelyMoreCannons.TurretTrackingExtension">
				<enableMidBurstTracking>true</enableMidBurstTracking>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_127mmOtobredaC_Weapon</defName>
		<label>Otobreda 127/54C Gun</label>
		<graphicData>
			<texPath>Things/Building/M127mmOtobredaC_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The Otobreda 127/54C was an Italian rapid-fire naval gun developed for surface combat and shore bombardment. Equipped with an automatic drum autoloader, it features selectable burst fire, an indirect fire variant, and is capable of settlement bombardment. Power: 700, HP: 1440, Cooldown: 2.0s, Range: 7-30000, Rate of Fire: 45 rounds per minute, Aimed Burst: 3, Reload Time: 1s. Ammunition: AP shell with 150 penetration and HE shell with 3.5m explosion radius.</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.2</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmMark16_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<minRange>7</minRange>
				<range>30000</range>
				<soundCast>Sound_Single127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<ticksBetweenBurstShots>40</ticksBetweenBurstShots>
				<burstShotCount>3</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
				<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>85</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_127mmMark16_Shells</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
				<aimedBurstShotCount>1</aimedBurstShotCount>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.TurretClampingExtension">
				<maxVerticalDeviation>2</maxVerticalDeviation>
				<maxRotationDeviation>2</maxRotationDeviation>
			</li>
		</modExtensions>
	</ThingDef>

