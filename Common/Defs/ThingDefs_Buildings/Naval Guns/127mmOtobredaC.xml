<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== Otobreda 127/54C ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_127mmOtobredaC</defName>
		<label>Otobreda 127/54C</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_127mmOtobredaC_Base</defName>
		<label>Otobreda 127/54C</label>
    <description>The Otobreda 127/54C was an Italian naval gun developed for rapid-fire against surface and shore targets. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 1440, Cooldown: 5.0s, Range: 7-22000, Rate of Fire: 12 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: AP shell with 150 penetration.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M127mmOtobredaC</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M127mmOtobredaC_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>1440</MaxHitPoints>
			<WorkToBuild>41500</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>1000</Steel>
      <ComponentIndustrial>25</ComponentIndustrial>
			<Plasteel>40</Plasteel>
      <ComponentSpacer>5</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_127mmOtobredaC_Weapon</turretGunDef>
      <turretTopDrawSize>11</turretTopDrawSize>
			<turretBurstCooldownTime>1.5</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_127mmOtobredaC</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>700</basePowerConsumption>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_127mmOtobredaC</li>
		</researchPrerequisites>
    <interactionCellOffset>(2,0,-2)</interactionCellOffset>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_127mmOtobredaC_Weapon</defName>
		<label>Otobreda 127/54C Gun</label>
		<graphicData>
			<texPath>Things/Building/M127mmOtobredaC_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The Otobreda 127/54C was an Italian naval gun developed for rapid-fire against surface and shore targets. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 6000, Cooldown: 5.0s, Range: 7-22000, Rate of Fire: 12 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: AP shell with 150 penetration.</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmMark16_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>7</minRange>
				<range>30000</range>
				<soundCast>Sound_Single127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>85</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_127mmMark16_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

