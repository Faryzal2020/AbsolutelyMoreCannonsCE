<?xml version="1.0" encoding="utf-8"?>
<Defs>
									
	<!--=============== 5"/54 (12.7 cm) Mark 16 ===============-->

	<DesignatorDropdownGroupDef>
		<defName>Group_AMC_127mmMark16</defName>
		<label>5"/54 (12.7 cm) Mark 16</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="AMCTurretMannedBase"> <!-- AMCTurretAutoBase -->
		<defName>Turret_127mmMark16_Base</defName>
		<label>5"/54 (12.7 cm) Mark 16</label>
    <description>The 5"/54 (12.7 cm) Mark 16 was a US dual-purpose naval gun designed for destroyers and cruisers. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 1792, Cooldown: 5.0s, Range: 7-19000, Rate of Fire: 12 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 3.5m explosion radius.</description>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/M127mmMark16</texPath>
			<drawSize>(14,14)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Icons/M127mmMark16_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>1792</MaxHitPoints>
			<WorkToBuild>44000</WorkToBuild>
			<Mass>1</Mass>
			<Bulk>1</Bulk>
		</statBases>
		<costList>
			<Steel>900</Steel>
      <ComponentIndustrial>20</ComponentIndustrial>
			<Plasteel>30</Plasteel>
      <ComponentSpacer>5</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>Turret_127mmMark16_Weapon</turretGunDef>
      <turretTopDrawSize>13</turretTopDrawSize>
			<turretBurstCooldownTime>3.3</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
		<designatorDropdown>Group_AMC_127mmMark16</designatorDropdown>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>500</basePowerConsumption>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
    <size>4,4</size>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Research_127mmMark16</li>
		</researchPrerequisites>
    <interactionCellOffset>(2,0,-2)</interactionCellOffset>
	</ThingDef>
	
	<ThingDef ParentName="BaseTurretGun">
		<defName>Turret_127mmMark16_Weapon</defName>
		<label>5"/54 (12.7 cm) Mark 16 Gun</label>
		<graphicData>
			<texPath>Things/Building/M127mmMark16_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>The 5"/54 (12.7 cm) Mark 16 was a US dual-purpose naval gun designed for destroyers and cruisers. It has an indirect fire variant, requires reloading after each shot, and is capable of settlement bombardment. Power: 350, HP: 6000, Cooldown: 5.0s, Range: 7-19000, Rate of Fire: 12 rounds per minute, Aimed Burst: 1, Reload Time: 1s. Ammunition: HE shell with 3.5m explosion radius.</description>
		<statBases>
			<SightsEfficiency>4</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.2</SwayFactor>
			<RangedWeapon_Cooldown>3.3</RangedWeapon_Cooldown>
			<Mass>1</Mass>
		</statBases>
		<soundInteract>AMC_Large_Reload</soundInteract>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_127mmMark16_HE</defaultProjectile>
				<warmupTime>0.5</warmupTime>
        <minRange>8</minRange>
				<range>23700</range>
				<soundCast>Sound_Single127mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>100</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>50</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>AmmoSet_127mmMark16_Shells</ammoSet>
			</li>
		</comps>
	</ThingDef>

