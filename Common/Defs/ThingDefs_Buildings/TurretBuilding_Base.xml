<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef Name="AMCBuildingBase" Abstract="True">
    <category>Building</category>
    <thingClass>Building</thingClass>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <selectable>true</selectable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <repairEffect>Repair</repairEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <statBases>
      <SellPriceFactor>0.70</SellPriceFactor>
    </statBases>
  </ThingDef>

  <ThingDef Name="AMCTurretBase" ParentName="AMCBuildingBase" Abstract="True">
    <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <WorkToMake>10000</WorkToMake>
      <Beauty>-10</Beauty>
    </statBases>
    <damageMultipliers>
      <li>
        <damageDef>Bullet</damageDef>
        <multiplier>0.5</multiplier>  <!-- 50% damage from bullets -->
      </li>
      <li>
        <damageDef>Bomb</damageDef>
        <multiplier>0.7</multiplier>  <!-- 70% damage from explosives -->
      </li>
      <li>
        <damageDef>Flame</damageDef>
        <multiplier>1</multiplier>  <!-- 100% damage from flames -->
      </li>
      <li>
        <damageDef>Blunt</damageDef>
        <multiplier>0.1</multiplier>  <!-- 10% damage from melee/blunt -->
      </li>
      <li>
        <damageDef>Cut</damageDef>
        <multiplier>0.1</multiplier>  <!-- 10% damage from cutting -->
      </li>
      <li>
        <damageDef>Stab</damageDef>
        <multiplier>0.1</multiplier>  <!-- 10% damage from stabbing -->
      </li>
      <li>
        <damageDef>Fragment</damageDef>
        <multiplier>0.2</multiplier>  <!-- 20% damage from fragmentation -->
      </li>
    </damageMultipliers>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>1</fillPercent>
    <blockLight>false</blockLight> 
    <castEdgeShadows>false</castEdgeShadows>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretBurstCooldownTime>1</turretBurstCooldownTime>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <designationCategory>AMC</designationCategory>
  </ThingDef>

  <ThingDef Name="AMCTurretAutoBase" ParentName="AMCTurretBase" Abstract="True">
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <tradeability>Buyable</tradeability>
    <tradeTags>
      <li>CE_Turret</li>
    </tradeTags>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>AMCTurrets</li>
    </thingCategories>
  </ThingDef>

  <ThingDef Name="AMCTurretMannedBase" ParentName="AMCTurretBase" Abstract="True">
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <comps>
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
      </li>
    </comps>
    <tradeability>None</tradeability>
    <building>
      <spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
    </building>
  </ThingDef>

  <ThingDef Name="AMCArtilleryBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Security/TurretMortar_Base</texPath>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <rect>(0.38,0.2,0.56375,0.8)</rect>
        <cornerTL>Damage/Corner</cornerTL>
      </damageData>
      <shadowData>
        <offset>(-0.13,-0.87,-0.1)</offset>
        <volume>(0.5,0.4,1.05)</volume>
      </shadowData>
    </graphicData>
    <tradeability>None</tradeability>
    <uiIconScale>1</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <stealable>false</stealable>
    <size>(2,2)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>1</fillPercent>
    <blockLight>false</blockLight> 
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>AMC</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
      </li>
    </comps>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>30</Mass>
      <Bulk>200</Bulk>
      <Beauty>-20</Beauty>
    </statBases>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretBurstWarmupTime>4.0</turretBurstWarmupTime>
      <turretBurstCooldownTime>2</turretBurstCooldownTime>
      <spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
      <buildingTags>
        <li>Artillery</li>
      </buildingTags>
    </building>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef Name="AMCArtilleryAutoBase" ParentName="AMCTurretAutoBase" Abstract="True">
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <tradeability Inherit="False">Buyable</tradeability>
  </ThingDef>
</Defs>