    </mote>
  </ThingDef>
  
  
      
   <ThingDef ParentName="MoteBase">
    <defName>AMC_NuclearMushroomringexpanse</defName>
    <graphicData>
      <texPath>Effects/NuclearMushroomring2</texPath>
      <shaderType>Transparent</shaderType>
