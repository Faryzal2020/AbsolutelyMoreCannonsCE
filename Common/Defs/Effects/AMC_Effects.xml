<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <EffecterDef>
    <defName>AMC_NukeEffect</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>AMC_Mote_NuclearFlash</moteDef>
        <scale>60~60</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>Mote_GiantExplosion</moteDef>
        <scale>2~2</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>Mote_GiantExplosionInner</moteDef>
        <scale>5~5</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>AMC_NuclearMushroom</moteDef>
        <scale>24~24</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>AMC_NuclearMushroom2a</moteDef>
        <scale>25~25</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>AMC_NuclearMushroomring</moteDef>
        <scale>60~60</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>AMC_NuclearMushroomringexpanse</moteDef>
        <scale>5~100</scale>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>AMC_MuzzleFlashLight</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>AMC_Mote_MuzzleFlash</moteDef>
        <scale>2~2.3</scale>
      </li>
    </children>
  </EffecterDef>
  
  <ThingDef ParentName="MoteBase">
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <defName>AMC_Mote_NuclearFlash</defName>
    <mote>
      <fadeInTime>1</fadeInTime>
      <solidTime>3</solidTime>
      <fadeOutTime>8</fadeOutTime>
      <growthRate>15</growthRate>
    </mote>
    <graphicData>
      <drawSize>25.3</drawSize>
      <drawOffset>(0,0,1)</drawOffset>
      <color>(255, 102, 0, 140)</color>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
  </ThingDef>
  
  <ThingDef ParentName="MoteBase">
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <defName>AMC_Mote_MuzzleFlash</defName>
    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>0.01</solidTime>
      <fadeOutTime>0</fadeOutTime>
      <growthRate>0</growthRate>
    </mote>
    <graphicData>
      <drawSize>2</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
      <color>(231, 222, 40, 140)</color>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
  </ThingDef>
  
   <ThingDef ParentName="MoteBase">
    <defName>AMC_NuclearMushroom</defName>
    <graphicData>
      <texPath>Effects/NuclearMushroom</texPath>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <thingClass>MoteThrownAttached</thingClass>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <growthRate>1</growthRate>
      <fadeInTime>1</fadeInTime>
      <solidTime>3</solidTime>
      <fadeOutTime>12</fadeOutTime>
    </mote>
  </ThingDef>
     <ThingDef ParentName="MoteBase">
    <defName>AMC_NuclearMushroom2a</defName>
    <graphicData>
      <texPath>Effects/NuclearMushroom2</texPath>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <thingClass>MoteThrownAttached</thingClass>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <growthRate>1</growthRate>
      <fadeInTime>10</fadeInTime>
      <solidTime>3</solidTime>
      <fadeOutTime>10</fadeOutTime>
    </mote>
  </ThingDef>
  
    
   <ThingDef ParentName="MoteBase">
    <defName>AMC_NuclearMushroomring</defName>
    <graphicData>
      <texPath>Effects/NuclearMushroomring</texPath>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <thingClass>MoteThrownAttached</thingClass>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <growthRate>15</growthRate>
      <fadeInTime>1</fadeInTime>
      <solidTime>3</solidTime>
