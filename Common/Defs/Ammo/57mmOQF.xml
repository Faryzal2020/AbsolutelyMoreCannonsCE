<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo57mmOQFShells</defName>
		<label>OQF 6-pounder 7 cwt shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/57mmOQFAP</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_57mmOQF_Shells</defName>
		<label>OQF 6-pounder 7 cwt ammunitions</label>
		<ammoTypes>
			<Ammo_57mmOQF_AP>Bullet_57mmOQF_AP</Ammo_57mmOQF_AP>
			<Ammo_57mmOQF_APDS>Bullet_57mmOQF_APDS</Ammo_57mmOQF_APDS>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo57mmOQFBase" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for OQF 6-pounder 7 cwt weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo57mmOQFShells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
		<isMortarAmmo>true</isMortarAmmo>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo57mmOQFBase">
		<defName>Ammo_57mmOQF_AP</defName>
		<label>57mm Shot Mk.8 (AP)</label>
		<graphicData>
			<texPath>Things/Projectile/57mmOQFAP</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>18.19</MarketValue>
			<Mass>3.77</Mass>
			<Bulk>7.53</Bulk>
		</statBases>
		<ammoClass>ArmorPiercing</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<detonateProjectile>Bullet_57mmOQF_AP</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo57mmOQFBase">
		<defName>Ammo_57mmOQF_APDS</defName>
		<label>57mm Shot Mk.1T (APDS)</label>
		<graphicData>
			<texPath>Things/Projectile/57mmOQFAPDS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>19.75</MarketValue>
			<Mass>2.33</Mass>
			<Bulk>7.53</Bulk>
		</statBases>
		<ammoClass>Sabot</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<detonateProjectile>Bullet_57mmOQF_APDS</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base57mmOQFBullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>0.6</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base57mmOQFBullet">
		<defName>Bullet_57mmOQF_AP</defName>
		<label>57mm Shot Mk.8 shell (AP)</label>
		<graphicData>
			<texPath>Things/Projectile/Cannon/AP</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>163</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>183</damageAmountBase>
			<explosionRadius>0</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<armorPenetrationSharp>116</armorPenetrationSharp>
			<armorPenetrationBlunt>22349.64</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base57mmOQFBullet">
		<defName>Bullet_57mmOQF_APDS</defName>
		<label>57mm Shot Mk.1T shell (APDS)</label>
		<graphicData>
			<texPath>Things/Projectile/Cannon/APCR</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>207</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>157</damageAmountBase>
			<explosionRadius>0</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<armorPenetrationSharp>177</armorPenetrationSharp>
			<armorPenetrationBlunt>21100.64</armorPenetrationBlunt>
		</projectile>

	</ThingDef>


	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_57mmOQF_AP</defName>
		<label>make 57mm Shot Mk.8 (AP) ammo x10</label>
		<description>Craft 10 57mm Shot Mk.8 (AP).</description>
		<jobString>Making 57mm Shot Mk.8 (AP).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>78</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_57mmOQF_AP>10</Ammo_57mmOQF_AP>
		</products>
		<workAmount>9360</workAmount>
	</RecipeDef>

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_57mmOQF_APDS</defName>
		<label>make 57mm Shot Mk.1T (APDS) ammo x10</label>
		<description>Craft 10 57mm Shot Mk.1T (APDS).</description>
		<jobString>Making 57mm Shot Mk.1T (APDS).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</filter>
				<count>35</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Plasteel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_57mmOQF_AP>10</Ammo_57mmOQF_AP>
		</products>
		<workAmount>20000</workAmount>
	</RecipeDef>

</Defs>