	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo120mmTAK120Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 120mm/46 weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo120mmTAK120Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo120mmTAK120Base">
		<defName>Ammo_120mmTAK120_HE</defName>
		<label>120mm slsgr m/95 (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/120mmTAK120HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
        	<drawRotated>false</drawRotated>
		</graphicData>
		<statBases>
			<MarketValue>230.87</MarketValue>
			<Mass>35</Mass>
			<Bulk>37.33</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_120mmTAK120_HE</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo120mmTAK120Base">
		<defName>Ammo_120mmTAK120_APHE</defName>
		<label>120mm Pansargranat m/94 (APHE)</label>
		<graphicData>
			<texPath>Things/Projectile/120mmTAK120APHE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
        	<drawRotated>false</drawRotated>
		</graphicData>
		<statBases>
			<MarketValue>233.4</MarketValue>
			<Mass>37</Mass>
			<Bulk>37.33</Bulk>
		</statBases>
		<ammoClass>ExplosiveAP</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_120mmTAK120_APHE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base120mmTAK120Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base120mmTAK120Bullet">
		<defName>Bullet_120mmTAK120_HE</defName>
		<label>120mm slsgr m/95 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Cannon/HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>151</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>262</damageAmountBase>
			<explosionRadius>3.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>39</Fragment_Large>
					<Fragment_Small>2</Fragment_Small>
				</fragments>
				<fragAngleRange>0~10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="Base120mmTAK120Bullet">
		<defName>Bullet_120mmTAK120_APHE</defName>
		<label>120mm Pansargranat m/94 shell (APHE)</label>
		<graphicData>
			<texPath>Things/Projectile/Cannon/APHE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>151</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>721</damageAmountBase>
			<armorPenetrationSharp>190</armorPenetrationSharp>
			<armorPenetrationBlunt>147200</armorPenetrationBlunt>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_ExplosiveCE">
				<damageAmountBase>1082</damageAmountBase>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<explosiveRadius>1</explosiveRadius>
				<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			</li>
		</comps>
	</ThingDef>

	<!-- ================== Indirect ================== -->
