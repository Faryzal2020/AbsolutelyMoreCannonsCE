<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo120mmTAK120Shells</defName>
		<label>120mm/46 shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/120mmTAK120HE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_120mmTAK120_Shells</defName>
		<label>120mm/46 ammunitions</label>
		<ammoTypes>
			<Ammo_120mmTAK120_HE>Bullet_120mmTAK120_HE</Ammo_120mmTAK120_HE>
			<Ammo_120mmTAK120_APHE>Bullet_120mmTAK120_APHE</Ammo_120mmTAK120_APHE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_120mmTAK120_indirect_Shells</defName>
		<label>120mm/46 ammunitions</label>
		<ammoTypes>
			<Ammo_120mmTAK120_HE>Bullet_120mmTAK120_indirect_HE</Ammo_120mmTAK120_HE>
			<Ammo_120mmTAK120_APHE>Bullet_120mmTAK120_indirect_APHE</Ammo_120mmTAK120_APHE>
