	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo75mmLEIG18Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 7.5cm L11.2 weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo75mmLEIG18Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo75mmLEIG18Base">
		<defName>Ammo_75mmLEIG18_HE</defName>
		<label>75mm Jgr. 18 (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/75mmLEIG18HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>130.08</MarketValue>
			<Mass>6.5</Mass>
			<Bulk>5.39</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_75mmLEIG18_HE</detonateProjectile>
	</ThingDef>


	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base75mmLEIG18Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>0.7</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base75mmLEIG18Bullet">
		<defName>Bullet_75mmLEIG18_HE</defName>
		<label>75mm Jgr. 18 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Cannon/HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>56</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>328</damageAmountBase>
			<explosionRadius>4</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>6</Fragment_Large>
					<Fragment_Small>3</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>


