<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo128mmPAK44Shells</defName>
		<label>12.8cm L55 shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/128mmPAK44APHE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_128mmPAK44_Shells</defName>
		<label>12.8cm L55 ammunitions</label>
		<ammoTypes>
			<Ammo_128mmPAK44_APHE>Bullet_128mmPAK44_APHE</Ammo_128mmPAK44_APHE>
			<Ammo_128mmPAK44_HE>Bullet_128mmPAK44_HE</Ammo_128mmPAK44_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo128mmPAK44Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 12.8cm L55 weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo128mmPAK44Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
		<isMortarAmmo>true</isMortarAmmo>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo128mmPAK44Base">
		<defName>Ammo_128mmPAK44_APHE</defName>
		<label>128mm Pzgr. (APHE)</label>
		<graphicData>
			<texPath>Things/Projectile/128mmPAK44APHE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>244.14</MarketValue>
			<Mass>37.25</Mass>
			<Bulk>70.65</Bulk>
		</statBases>
		<ammoClass>ExplosiveAP</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<detonateProjectile>Bullet_128mmPAK44_APHE</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo128mmPAK44Base">
		<defName>Ammo_128mmPAK44_HE</defName>
		<label>128mm Sprgr. L/5 (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/128mmPAK44HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>257.89</MarketValue>
			<Mass>38.9</Mass>
			<Bulk>70.65</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<detonateProjectile>Bullet_128mmPAK44_HE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base128mmPAK44Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base128mmPAK44Bullet">
		<defName>Bullet_128mmPAK44_APHE</defName>
		<label>128mm Pzgr. shell (APHE)</label>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>ThumpCannon_Impact</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>169</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>858</damageAmountBase>
			<armorPenetrationSharp>252</armorPenetrationSharp>
			<armorPenetrationBlunt>227901.16</armorPenetrationBlunt>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_ExplosiveCE">
				<damageAmountBase>1287</damageAmountBase>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<explosiveRadius>1</explosiveRadius>
				<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="Base128mmPAK44Bullet">
		<defName>Bullet_128mmPAK44_HE</defName>
		<label>128mm Sprgr. L/5 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>144</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>289</damageAmountBase>
			<explosionRadius>3.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>3</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_128mmPAK44_APHE</defName>
		<label>make 128mm Pzgr. (APHE) ammo x5</label>
		<description>Craft 5 128mm Pzgr. (APHE).</description>
		<jobString>Making 128mm Pzgr. (APHE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>374</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>42</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_128mmPAK44_APHE>5</Ammo_128mmPAK44_APHE>
		</products>
		<workAmount>54200</workAmount>
	</RecipeDef>

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_128mmPAK44_HE</defName>
		<label>make 128mm Sprgr. L/5 (HE) ammo x5</label>
		<description>Craft 5 128mm Sprgr. L/5 (HE).</description>
		<jobString>Making 128mm Sprgr. L/5 (HE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>390</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>38</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>ComponentIndustrial</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_128mmPAK44_HE>5</Ammo_128mmPAK44_HE>
		</products>
		<workAmount>55400</workAmount>
	</RecipeDef>

</Defs>