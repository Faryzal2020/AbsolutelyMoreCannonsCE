<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo106mmM40Shells</defName>
		<label>M40 Recoilless Rifle shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/106mmM40HEAT</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_106mmM40_Shells</defName>
		<label>M40 Recoilless Rifle ammunitions</label>
		<ammoTypes>
			<Ammo_106mmM40_HEAT>Bullet_106mmM40_HEAT</Ammo_106mmM40_HEAT>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo106mmM40Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for M40 Recoilless Rifle weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo106mmM40Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo106mmM40Base">
		<defName>Ammo_106mmM40_HEAT</defName>
		<label>106mm M344 (HEAT)</label>
		<graphicData>
			<texPath>Things/Projectile/106mmM40HEAT</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>122.54</MarketValue>
			<Mass>16.45</Mass>
			<Bulk>31.12</Bulk>
		</statBases>
		<ammoClass>RocketHEAT</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_106mmM40_HEAT</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base106mmM40Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base106mmM40Bullet">
		<defName>Bullet_106mmM40_HEAT</defName>
		<label>106mm M344 shell (HEAT)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Recoilless/HEAT</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>107</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>248</damageAmountBase>
			<explosionRadius>1.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<armorPenetrationSharp>400</armorPenetrationSharp>
			<armorPenetrationBlunt>62.673</armorPenetrationBlunt>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_ExplosiveCE">
				<damageAmountBase>209</damageAmountBase>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<explosiveRadius>1</explosiveRadius>
				<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			</li>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>7</Fragment_Large>
					<Fragment_Small>1</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_106mmM40_HEAT</defName>
		<label>make 106mm M344 (HEAT) ammo x10</label>
		<description>Craft 10 106mm M344 (HEAT).</description>
		<jobString>Making 106mm M344 (HEAT).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>330</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>46</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>ComponentIndustrial</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_106mmM40_HEAT>10</Ammo_106mmM40_HEAT>
		</products>
		<workAmount>52600</workAmount>
	</RecipeDef>

</Defs>