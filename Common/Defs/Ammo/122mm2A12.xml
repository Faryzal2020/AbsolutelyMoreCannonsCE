<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo122mm2A12Shells</defName>
		<label>122 mm 2A12  shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/122mm2A12HE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_122mm2A12_Shells</defName>
		<label>122 mm 2A12  ammunitions</label>
		<ammoTypes>
			<Ammo_122mm2A12_HE>Bullet_122mm2A12_HE</Ammo_122mm2A12_HE>
			<Ammo_122mm2A12_AB>Bullet_122mm2A12_AB</Ammo_122mm2A12_AB>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_122mm2A12_indirect_Shells</defName>
		<label>122 mm 2A12  ammunitions</label>
		<ammoTypes>
			<Ammo_122mm2A12_HE>Bullet_122mm2A12_indirect_HE</Ammo_122mm2A12_HE>
