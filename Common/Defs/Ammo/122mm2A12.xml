	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo122mm2A12Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 122 mm 2A12  weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo122mm2A12Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo122mm2A12Base">
		<defName>Ammo_122mm2A12_HE</defName>
		<label>122mm OF-462 (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/122mm2A12HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>216.32</MarketValue>
			<Mass>30.06</Mass>
			<Bulk>35.25</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_122mm2A12_HE</detonateProjectile>
	</ThingDef>


	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo122mm2A12Base">
		<defName>Ammo_122mm2A12_AB</defName>
		<label>122mm OF-462 (Airburst)</label>
		<graphicData>
			<texPath>Things/Projectile/122mm2A12HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>240.0</MarketValue>
			<Mass>29.5</Mass>
			<Bulk>35.25</Bulk>
		</statBases>
		<ammoClass>GrenadeHETF</ammoClass>
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_122mm2A12_AB</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base122mm2A12Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base122mm2A12Bullet">
		<defName>Bullet_122mm2A12_HE</defName>
		<label>122mm OF-462 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
                <soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>134</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>279</damageAmountBase>
			<explosionRadius>3.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>3</Fragment_Small>
				</fragments>
				<fragAngleRange>0~0.5</fragAngleRange>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="Base122mm2A12Bullet">
		<defName>Bullet_122mm2A12_AB</defName>
		<label>122mm OF-462 shell (Airburst)</label>
		<thingClass>AbsolutelyMoreCannons.ProjectileCE_Airburst</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>134</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>0</damageAmountBase>
			<explosionRadius>0</explosionRadius>
			<aimHeightOffset>1.4</aimHeightOffset>
		</projectile>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_AirburstFragments">
				<fragments>
					<li>
						<thingDef>Airburst_Fragment</thingDef>
						<count>30</count>
						<explosionRadius>1</explosionRadius>
					</li>
					<li>
						<thingDef>Fragment_Small</thingDef>
						<count>30</count>
					</li>
				</fragments>
				<fragAngleRange>-20~-1</fragAngleRange>
				<fragXZAngleRange>-30~30</fragXZAngleRange>
				<useEllipticalCone>true</useEllipticalCone>
				<usePolarDiskSampling>true</usePolarDiskSampling>
				<airburstSound>Explosion_Bomb</airburstSound>
				<airburstFlashEffect>AMC_MuzzleFlashLight</airburstFlashEffect>
				<airburstFlashScale>10.0</airburstFlashScale>
				<airburstSmokeScale>1.0</airburstSmokeScale>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.AirburstExtension">
				<armingTicks>12</armingTicks>
				<type>Flak</type>
				<proximityRadius>5</proximityRadius>
			</li>
		</modExtensions>
	</ThingDef>

