<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo122mm2A12Shells</defName>
		<label>122 mm 2A12  shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/122mm2A12HE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_122mm2A12_Shells</defName>
		<label>122 mm 2A12  ammunitions</label>
		<ammoTypes>
			<Ammo_122mm2A12_HE>Bullet_122mm2A12_HE</Ammo_122mm2A12_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_122mm2A12_indirect_Shells</defName>
		<label>122 mm 2A12  ammunitions</label>
		<ammoTypes>
			<Ammo_122mm2A12_HE>Bullet_122mm2A12_indirect_HE</Ammo_122mm2A12_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo122mm2A12Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 122 mm 2A12  weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo122mm2A12Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo122mm2A12Base">
		<defName>Ammo_122mm2A12_HE</defName>
		<label>122mm OF-462 (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/122mm2A12HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>216.32</MarketValue>
			<Mass>30.06</Mass>
			<Bulk>35.25</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_122mm2A12_HE</detonateProjectile>
	</ThingDef>


	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base122mm2A12Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base122mm2A12Bullet">
		<defName>Bullet_122mm2A12_HE</defName>
		<label>122mm OF-462 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
                <soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>134</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>279</damageAmountBase>
			<explosionRadius>3.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>3</Fragment_Small>
				</fragments>
				<fragAngleRange>0~0.5</fragAngleRange>
			</li>
		</comps>
	</ThingDef>



	<!-- ================== Indirect ================== -->
	<ThingDef Name="Base122mm2A12IndirectBullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>0</speed>
			<flyOverhead>true</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<gravityFactor>5</gravityFactor>
			<shellingProps>
				<tilesPerTick>0.15</tilesPerTick>
				<range>18</range>
			</shellingProps>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base122mm2A12IndirectBullet">
		<defName>Bullet_122mm2A12_indirect_HE</defName>
		<label>122mm OF-462 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
                <soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>279</damageAmountBase>
			<explosionRadius>3.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<shellingProps>
				<damage>0.217</damage>
			</shellingProps>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>3</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_122mm2A12_HE</defName>
		<label>make 122mm OF-462 (HE) ammo x5</label>
		<description>Craft 5 122mm OF-462 (HE).</description>
		<jobString>Making 122mm OF-462 (HE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>302</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
