<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo90mmM26Shells</defName>
		<label>90mm Gun M3 shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/90mmM26APHE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_90mmM26_Shells</defName>
		<label>90mm Gun M3 ammunitions</label>
		<ammoTypes>
			<Ammo_90mmM26_APHE>Bullet_90mmM26_APHE</Ammo_90mmM26_APHE>
			<Ammo_90mmM26_HE>Bullet_90mmM26_HE</Ammo_90mmM26_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo90mmM26Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 90mm Gun M3 weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo90mmM26Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
		<isMortarAmmo>true</isMortarAmmo>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo90mmM26Base">
		<defName>Ammo_90mmM26_APHE</defName>
		<label>90mm M82 (APHE)</label>
		<graphicData>
			<texPath>Things/Projectile/90mmM26APHE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>119.86</MarketValue>
			<Mass>19.05</Mass>
			<Bulk>22.88</Bulk>
		</statBases>
		<ammoClass>ExplosiveAP</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<detonateProjectile>Bullet_90mmM26_APHE</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo90mmM26Base">
		<defName>Ammo_90mmM26_HE</defName>
		<label>90mm M71 (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/90mmM26HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>110.58</MarketValue>
			<Mass>18.66</Mass>
			<Bulk>22.88</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<detonateProjectile>Bullet_90mmM26_HE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base90mmM26Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base90mmM26Bullet">
		<defName>Bullet_90mmM26_APHE</defName>
		<label>90mm M82 shell (APHE)</label>
		<graphicData>
			<texPath>Things/Projectile/MediumShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>ThumpCannon_Impact</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>153</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>510</damageAmountBase>
			<armorPenetrationSharp>173</armorPenetrationSharp>
			<armorPenetrationBlunt>72310</armorPenetrationBlunt>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_ExplosiveCE">
				<screenShakeFactor>0.4</screenShakeFactor>
				<damageAmountBase>766</damageAmountBase>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<explosiveRadius>1</explosiveRadius>
				<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="Base90mmM26Bullet">
		<defName>Bullet_90mmM26_HE</defName>
		<label>90mm M71 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/MediumShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>154</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>126</damageAmountBase>
			<explosionRadius>2.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>21</Fragment_Large>
					<Fragment_Small>1</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_90mmM26_APHE</defName>
		<label>make 90mm M82 (APHE) ammo x10</label>
		<description>Craft 10 90mm M82 (APHE).</description>
		<jobString>Making 90mm M82 (APHE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>384</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>37</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_90mmM26_APHE>10</Ammo_90mmM26_APHE>
		</products>
		<workAmount>53200</workAmount>
	</RecipeDef>

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_90mmM26_HE</defName>
		<label>make 90mm M71 (HE) ammo x10</label>
		<description>Craft 10 90mm M71 (HE).</description>
		<jobString>Making 90mm M71 (HE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>376</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>21</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>ComponentIndustrial</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_90mmM26_HE>10</Ammo_90mmM26_HE>
		</products>
		<workAmount>47200</workAmount>
	</RecipeDef>

</Defs>