	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base152mm2A65Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base152mm2A65Bullet">
		<defName>Bullet_152mm2A65_HE</defName>
		<label>152mm OF-540 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.5</screenShakeFactor>
			<speed>130</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>386</damageAmountBase>
			<explosionRadius>4.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>4</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="Base152mm2A65Bullet">
		<defName>Bullet_152mm2A65_AB</defName>
		<label>152mm OF-540 shell (Airburst)</label>
		<thingClass>AbsolutelyMoreCannons.ProjectileCE_Airburst</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<soundExplode>MortarBomb_Explode</soundExplode>
			<screenShakeFactor>0.4</screenShakeFactor>
			<speed>130</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>0</damageAmountBase>
			<explosionRadius>0</explosionRadius>
			<aimHeightOffset>1.4</aimHeightOffset>
		</projectile>
		<comps>
			<li Class="AbsolutelyMoreCannons.CompProperties_AirburstFragments">
				<fragments>
					<li>
						<thingDef>Airburst_Fragment</thingDef>
						<count>40</count>
						<explosionRadius>1</explosionRadius>
					</li>
					<li>
						<thingDef>Fragment_Small</thingDef>
						<count>40</count>
					</li>
				</fragments>
				<fragAngleRange>-20~-1</fragAngleRange>
				<fragXZAngleRange>-30~30</fragXZAngleRange>
				<useEllipticalCone>true</useEllipticalCone>
				<usePolarDiskSampling>true</usePolarDiskSampling>
				<airburstSound>Explosion_Bomb</airburstSound>
				<airburstFlashEffect>AMC_MuzzleFlashLight</airburstFlashEffect>
				<airburstFlashScale>10.0</airburstFlashScale>
				<airburstSmokeScale>1.0</airburstSmokeScale>
			</li>
		</comps>
		<modExtensions>
			<li Class="AbsolutelyMoreCannons.AirburstExtension">
				<armingTicks>12</armingTicks>
				<type>Flak</type>
				<proximityRadius>5</proximityRadius>
			</li>
		</modExtensions>
	</ThingDef>

