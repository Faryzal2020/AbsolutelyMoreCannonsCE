	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo152mm2A65Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 152.4mm 2A65 weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
