	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_127mmMark16_HE</defName>
		<label>make 5" HC Mark 41 Mod 0 (HE) ammo x5</label>
		<description>Craft 5 5" HC Mark 41 Mod 0 (HE).</description>
		<jobString>Making 5" HC Mark 41 Mod 0 (HE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>458</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>33</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
