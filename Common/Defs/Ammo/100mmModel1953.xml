<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo100mmModel1953Shells</defName>
		<label>100mm/55 shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/100mmModel1953HE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_100mmModel1953_Shells</defName>
		<label>100mm/55 ammunitions</label>
		<ammoTypes>
			<Ammo_100mmModel1953_HE>Bullet_100mmModel1953_HE</Ammo_100mmModel1953_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_100mmModel1953_indirect_Shells</defName>
		<label>100mm/55 ammunitions</label>
		<ammoTypes>
			<Ammo_100mmModel1953_HE>Bullet_100mmModel1953_indirect_HE</Ammo_100mmModel1953_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo100mmModel1953Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 100mm/55 weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo100mmModel1953Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo100mmModel1953Base">
		<defName>Ammo_100mmModel1953_HE</defName>
		<label>100mm OEA F1 (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/100mmModel1953HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>135.4</MarketValue>
			<Mass>23.5</Mass>
			<Bulk>25.57</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_100mmModel1953_HE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base100mmModel1953Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base100mmModel1953Bullet">
		<defName>Bullet_100mmModel1953_HE</defName>
		<label>100mm OEA F1 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>160</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>139</damageAmountBase>
			<explosionRadius>2.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>27</Fragment_Large>
					<Fragment_Small>1</Fragment_Small>
				</fragments>
				<fragAngleRange>0~10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ================== Indirect ================== -->
	<ThingDef Name="Base100mmModel1953IndirectBullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>0</speed>
			<flyOverhead>true</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<gravityFactor>5</gravityFactor>
			<shellingProps>
				<tilesPerTick>0.15</tilesPerTick>
				<range>18</range>
			</shellingProps>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base100mmModel1953IndirectBullet">
		<defName>Bullet_100mmModel1953_indirect_HE</defName>
		<label>100mm OEA F1 shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>139</damageAmountBase>
			<explosionRadius>2.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<shellingProps>
				<damage>0.09928571428571428</damage>
			</shellingProps>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>27</Fragment_Large>
					<Fragment_Small>1</Fragment_Small>
				</fragments>
				<fragAngleRange>0~10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_100mmModel1953_HE</defName>
		<label>make 100mm OEA F1 (HE) ammo x10</label>
		<description>Craft 10 100mm OEA F1 (HE).</description>
		<jobString>Making 100mm OEA F1 (HE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>470</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>ComponentIndustrial</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_100mmModel1953_HE>10</Ammo_100mmModel1953_HE>
		</products>
		<workAmount>58200</workAmount>
	</RecipeDef>

</Defs>