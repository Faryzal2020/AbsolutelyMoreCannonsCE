<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo30x170mmShells</defName>
		<label>L21A1 RARDEN shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/30x170mm/HEI/HEI_b</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_30x170mm_Shells</defName>
		<label>L21A1 RARDEN ammunitions</label>
		<ammoTypes>
			<Ammo_30x170mm_HE>Bullet_30x170mm_HE</Ammo_30x170mm_HE>
			<Ammo_30x170mm_APDS>Bullet_30x170mm_APDS</Ammo_30x170mm_APDS>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
		<similarTo>AmmoSet_30x170mm</similarTo>
	</CombatExtended.AmmoSetDef>


	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo30x170mmBase" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for L21A1 RARDEN weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo30x170mmShells</li>
		</thingCategories>
		<stackLimit>150</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo30x170mmBase">
		<defName>Ammo_30x170mm_HE</defName>
		<label>30x170mm (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/30x170mm/HEI</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>6.92</MarketValue>
			<Mass>0.822</Mass>
			<Bulk>1.13</Bulk>
		</statBases>
		<ammoClass>GrenadeIncendiary</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>false</isMortarAmmo>
		<cookOffProjectile>Bullet_30x170mm_HE</cookOffProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo30x170mmBase">
		<defName>Ammo_30x170mm_APDS</defName>
		<label>30x170mm (APDS)</label>
		<graphicData>
			<texPath>Things/Projectile/30x170mm/APDS</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>10.31</MarketValue>
			<Mass>0.822</Mass>
			<Bulk>1.13</Bulk>
		</statBases>
		<ammoClass>Sabot</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>false</isMortarAmmo>
		<cookOffProjectile>Bullet_30x170mm_APDS</cookOffProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base30x170mmBullet" ParentName="BaseBulletCE" Abstract="true">
		<graphicData>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_RifleAmmoCasings_HighCal</casingMoteDefname>
			<casingFilthDefname>Filth_RifleAmmoCasings_HighCal</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base30x170mmBullet">
		<defName>Bullet_30x170mm_HE</defName>
		<label>30x170mm shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>ThumpCannon_Impact</soundExplode>
			<screenShakeFactor>0.01</screenShakeFactor>
			<speed>188</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>20</damageAmountBase>
			<explosionRadius>0.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>1</Fragment_Large>
					<Fragment_Small>1</Fragment_Small>
				</fragments>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="Base30x170mmBullet">
		<defName>Bullet_30x170mm_APDS</defName>
		<label>30x170mm shell (APDS)</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>201</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>71</damageAmountBase>
			<explosionRadius>0</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<armorPenetrationSharp>110</armorPenetrationSharp>
			<armorPenetrationBlunt>4141.88</armorPenetrationBlunt>
		</projectile>
	</ThingDef>


	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_30x170mm_HE</defName>
		<label>make 30x170mm (HE) ammo x50</label>
		<description>Craft 50 30x170mm (HE).</description>
		<jobString>Making 30x170mm (HE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>84</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>3</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>6</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>ComponentIndustrial</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_30x170mm_HE>50</Ammo_30x170mm_HE>
		</products>
		<workAmount>12600</workAmount>
	</RecipeDef>

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_30x170mm_APDS</defName>
		<label>make 30x170mm (APDS) ammo x50</label>
		<description>Craft 50 30x170mm (APDS).</description>
		<jobString>Making 30x170mm (APDS).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>54</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</filter>
				<count>36</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Plasteel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_30x170mm_APDS>50</Ammo_30x170mm_APDS>
		</products>
		<workAmount>24750</workAmount>
	</RecipeDef>

</Defs>