	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo150mmKC36Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 150mm/48 weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo150mmKC36Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo150mmKC36Base">
		<defName>Ammo_150mmKC36_HE</defName>
		<label>15 cm Spgr. L/4,5 Kz (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/150mmKC36HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>422.08</MarketValue>
			<Mass>68.8</Mass>
			<Bulk>81.91</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_150mmKC36_HE</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo150mmKC36Base">
		<defName>Ammo_150mmKC36_APHE</defName>
