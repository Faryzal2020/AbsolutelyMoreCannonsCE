	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base150mmKC36Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base150mmKC36Bullet">
		<defName>Bullet_150mmKC36_HE</defName>
		<label>15 cm Spgr. L/4,5 Kz shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>156</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>299</damageAmountBase>
			<explosionRadius>4</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>3</Fragment_Small>
				</fragments>
				<fragAngleRange>0~10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="Base150mmKC36Bullet">
		<defName>Bullet_150mmKC36_APHE</defName>
		<label>15 cm Pzgr. L/3,7 shell (APHE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>161</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>1050</damageAmountBase>
			<explosionRadius>0</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<armorPenetrationSharp>300</armorPenetrationSharp>
			<armorPenetrationBlunt>348359.38</armorPenetrationBlunt>
			<secondaryDamage>
		        <li>
		          <def>Bomb_Secondary</def>
		          <amount>1574</amount>
		        </li>
		    </secondaryDamage>
		</projectile>
	</ThingDef>

