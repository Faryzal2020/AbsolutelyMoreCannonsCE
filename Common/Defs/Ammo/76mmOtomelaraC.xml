	<ThingDef ParentName="Base76mmOtomelaraCBullet">
		<defName>Bullet_76mmOtomelaraC_HE</defName>
		<label>76x636mm shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
