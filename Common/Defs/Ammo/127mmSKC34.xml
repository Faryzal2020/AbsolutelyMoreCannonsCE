		<iconPath>Things/Projectile/127mmSKC34HE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_127mmSKC34_Shells</defName>
		<label>127mm/45 ammunitions</label>
		<ammoTypes>
			<Ammo_127mmSKC34_HE>Bullet_127mmSKC34_HE</Ammo_127mmSKC34_HE>
