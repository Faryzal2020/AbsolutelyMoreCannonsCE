<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo233mmBLMK1Shells</defName>
		<label>9.2-Inch Howitzer shells</label>
		<parent>AMCShells</parent>
		<iconPath>Things/Projectile/233mmBLMK1HE</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_233mmBLMK1_Shells</defName>
		<label>9.2-Inch Howitzer ammunitions</label>
		<ammoTypes>
			<Ammo_233mmBLMK1_HE>Bullet_233mmBLMK1_HE</Ammo_233mmBLMK1_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_233mmBLMK1_indirect_Shells</defName>
		<label>9.2-Inch Howitzer ammunitions</label>
		<ammoTypes>
			<Ammo_233mmBLMK1_HE>Bullet_233mmBLMK1_indirect_HE</Ammo_233mmBLMK1_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo233mmBLMK1Base" ParentName="MediumAmmoBase" Abstract="True">
		<description>Ammunitions for 9.2-Inch Howitzer weapon type</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_CNCmachine</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<li MayRequire="AMandRP10.ND">CE_AutoEnableCrafting_ArtilleryMachining</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo233mmBLMK1Shells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo233mmBLMK1Base">
		<defName>Ammo_233mmBLMK1_HE</defName>
		<label>9.2 Inch Mk.I (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/233mmBLMK1HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>828.38</MarketValue>
			<Mass>150</Mass>
			<Bulk>141.3</Bulk>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
	  	<!-- ammo class choices:
	  	ArmorPiercing, Sabot, IncendiaryAP, ExplosiveAP, IncendiaryFuel, GrenadeHE, GrenadeIncendiary, RocketHEAT, Antigrain, RadiationIonising -->
		<isMortarAmmo>true</isMortarAmmo>
		<detonateProjectile>Bullet_233mmBLMK1_HE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base233mmBLMK1Bullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base233mmBLMK1Bullet">
		<defName>Bullet_233mmBLMK1_HE</defName>
		<label>9.2 Inch Mk.I shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<speed>126</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>462</damageAmountBase>
			<explosionRadius>5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>6</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ================== Indirect ================== -->
	<ThingDef Name="Base233mmBLMK1IndirectBullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>0</speed>
			<flyOverhead>true</flyOverhead>
			<dropsCasings>false</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
			<soundImpactAnticipate>AMC_Directfire_PreImpact</soundImpactAnticipate>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<gravityFactor>5</gravityFactor>
			<shellingProps>
				<tilesPerTick>0.15</tilesPerTick>
				<range>12</range>
			</shellingProps>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base233mmBLMK1IndirectBullet">
		<defName>Bullet_233mmBLMK1_indirect_HE</defName>
		<label>9.2 Inch Mk.I shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/LargeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
            <soundExplode>MortarBomb_Explode</soundExplode>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>462</damageAmountBase>
			<explosionRadius>5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<shellingProps>
				<damage>0.385</damage>
			</shellingProps>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>6</Fragment_Small>
				</fragments>
				<fragAngleRange>-90~-10</fragAngleRange>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AdvancedAmmoRecipeBase">
		<defName>MakeAmmo_233mmBLMK1_HE</defName>
		<label>make 9.2 Inch Mk.I (HE) ammo x1</label>
		<description>Craft 1 9.2 Inch Mk.I (HE).</description>
		<jobString>Making 9.2 Inch Mk.I (HE).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>300</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>13</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>ComponentIndustrial</li>
				<li>FSX</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_233mmBLMK1_HE>1</Ammo_233mmBLMK1_HE>
		</products>
		<workAmount>35800</workAmount>
	</RecipeDef>


</Defs>