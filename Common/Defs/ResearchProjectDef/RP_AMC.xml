<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ResearchProjectDef>
    <defName>HeavyCannons</defName>
    <label>Large Caliber Cannon Turrets</label>
    <description>Allows you to get started in the AMC Tech tree</description>
    <baseCost>200</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>PrecisionRifling</li>
    </prerequisites>
    <researchViewX>0</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>HeavyAutocannons</defName>
    <label>Autocannon Turrets</label>
    <description>Allows you to build fast-firing high caliber cannons.</description>
    <baseCost>200</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>HeavyCannons</li>
      <li>Fabrication</li>
    </prerequisites>
    <researchViewX>1</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>Howitzers</defName>
    <label>Artillery Cannons</label>
    <description>Allows you to build artillery cannon turrets that can shoot over walls.</description>
    <baseCost>500</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>HeavyCannons</li>
      <li>Mortars</li>
      <li>Fabrication</li>
    </prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>NavalGuns</defName>
    <label>Naval Guns</label>
    <description>Unlocks access to naval gun research nodes.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>Howitzers</li>
      <li>Fabrication</li>
      <li>HeavyAutocannons</li>
    </prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>RFNavalGuns</defName>
    <label>Rapid Firing Naval Guns</label>
    <description>Unlocks access to naval guns with relatively quick reload rate, able to shoot directly and over walls.</description>
    <baseCost>100</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>NavalGuns</li>
      <li>AdvancedFabrication</li>
    </prerequisites>
    <researchViewX>4</researchViewX>
    <researchViewY>2</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>HeavyNavalGuns</defName>
    <label>Heavy Naval Guns</label>
    <description>Unlocks access to higher caliber naval guns that can shoot over walls.</description>
    <baseCost>100</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>NavalGuns</li>
    </prerequisites>
    <researchViewX>4</researchViewX>
    <researchViewY>1.5</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>RotaryCannons</defName>
    <label>Rotary Gun Turrets</label>
    <description>Allows you to build fast-firing rotary gun turrets.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>HeavyAutocannons</li>
      <li>Fabrication</li>
    </prerequisites>
    <researchViewX>5</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>Automated_FCS</defName>
    <label>automated fire control system</label>
    <description>Allows you to make Automated FCS computers, a necessary material to build unmanned cannon turrets.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>AdvancedFabrication</li>
    </prerequisites>
    <researchViewX>8</researchViewX>
    <researchViewY>0.5</researchViewY>
    <tab>AMC_General</tab>
  </ResearchProjectDef>
</Defs>